---
import Logo from "./Logo.astro";
import { localePath, locales, translator, type Locale } from "../i18n";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = translator(locale);
const home = localePath(locale);
const links = [
  { href: "#firmar", key: "nav.how" },
  { href: "#caracteristicas", key: "nav.features" },
  { href: "#comparativa", key: "nav.comparison" },
  { href: "#instalacion", key: "nav.install" },
  { href: "#transparencia", key: "nav.transparency" },
] as const;
---

<header
  style="position:sticky;top:0;z-index:150;background:rgba(255,255,255,.88);backdrop-filter:blur(12px);-webkit-backdrop-filter:blur(12px);border-bottom:1px solid var(--rf-border-subtle)"
>
  <nav
    aria-label={t("nav.aria")}
    style="max-width:76rem;margin:0 auto;padding:0 clamp(16px,4vw,32px);min-height:72px;display:flex;align-items:center;gap:clamp(12px,3vw,32px)"
  >
    <a
      href={home}
      aria-label={t("nav.home.aria")}
      style="display:flex;align-items:center;gap:10px;text-decoration:none;color:inherit;flex:none"
    >
      <Logo size={34} disc="#067781" stroke="#ffffff" />
      <span style="font-size:1.3rem;font-weight:800;letter-spacing:-.02em">rFirma</span>
      <span
        class="rf-badge"
        data-hide-sm
        style="border-color:var(--rf-brand-border);background:var(--rf-brand-surface);color:var(--rf-brand-text)"
        >{t("nav.badge.alpha")}</span
      >
    </a>

    <ul
      data-navlinks
      style="list-style:none;margin:0;padding:0;align-items:center;gap:clamp(14px,2.2vw,28px);white-space:nowrap"
    >
      {
        links.map((link) => (
          <li>
            <a
              href={link.href}
              style="text-decoration:none;font-size:.9375rem;font-weight:500;color:var(--rf-text-muted)"
            >
              {t(link.key)}
            </a>
          </li>
        ))
      }
    </ul>

    <div style="flex:1"></div>

    <details class="lang">
      <summary
        class="rf-btn rf-btn--ghost lang__summary"
        aria-label={t("lang.aria")}
        style="color:var(--rf-text);padding:0 10px;gap:6px"
      >
        <svg
          width="18"
          height="18"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
          ><path d="M4 5h7M7.5 3v2M6 5c0 4 2.5 6.5 5.5 7.5M10 5c-.5 3-2.5 5.5-6 7"></path><path
            d="M14 21l4-9 4 9M15.5 18h5"></path></svg
        >
        <span>{t(`lang.${locale}` as const)}</span>
        <svg
          width="14"
          height="14"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
          stroke-linecap="round"
          aria-hidden="true"><path d="M6 9l6 6 6-6"></path></svg
        >
      </summary>
      <ul class="lang__menu" aria-label={t("lang.aria")}>
        {
          locales.map((other) => (
            <li>
              <a
                class="lang__link"
                href={localePath(other)}
                hreflang={other}
                lang={other}
                aria-current={other === locale ? "page" : undefined}
              >
                {other === locale ? (
                  <svg
                    width="16"
                    height="16"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.4"
                    stroke-linecap="round"
                    aria-hidden="true"
                  >
                    <path d="M4 12.5 9.5 18 20 6" />
                  </svg>
                ) : null}
                <span>{t(`lang.${other}` as const)}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </details>

    <a
      href="https://github.com/sgomez/rfirma"
      target="_blank"
      rel="noopener noreferrer"
      class="rf-btn rf-btn--secondary"
      aria-label={t("nav.github")}
      style="flex:none;text-decoration:none"
    >
      <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"
        ><path
          d="M12 2A10 10 0 0 0 2 12c0 4.42 2.87 8.17 6.84 9.5.5.08.66-.23.66-.5v-1.69c-2.77.6-3.36-1.34-3.36-1.34-.46-1.16-1.11-1.47-1.11-1.47-.91-.62.07-.6.07-.6 1 .07 1.53 1.03 1.53 1.03.87 1.52 2.34 1.07 2.91.83.1-.65.35-1.09.63-1.34-2.22-.25-4.55-1.11-4.55-4.92 0-1.11.38-2 1.03-2.71-.1-.25-.45-1.29.1-2.64 0 0 .84-.27 2.75 1.02.79-.22 1.65-.33 2.5-.33.85 0 1.71.11 2.5.33 1.91-1.29 2.75-1.02 2.75-1.02.55 1.35.2 2.39.1 2.64.65.71 1.03 1.6 1.03 2.71 0 3.82-2.34 4.66-4.57 4.91.36.31.69.92.69 1.85V21c0 .27.16.59.67.5C19.14 20.16 22 16.42 22 12A10 10 0 0 0 12 2z"
        ></path></svg
      >
      <span data-hide-sm>{t("nav.github")}</span>
    </a>
  </nav>
</header>
