{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "rfirma",
  "version": "0.1.0",
  "identifier": "me.sgomez.rfirma",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "pnpm exec vite",
    "beforeBuildCommand": ""
  },
  "app": {
    "windows": [
      {
        "title": "rFirma",
        "width": 1280,
        "height": 720,
        "minWidth": 1100,
        "minHeight": 560,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "rpm"],
    "category": "Utility",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.png"],
    "linux": {
      "deb": {
        "files": {
          "/usr/lib/rfirma/librfirma_crypto.so": "../../rfirma-native-bridge/target/lib/rfirma/librfirma_crypto.so",
          "/usr/share/kio/servicemenus/rfirma-sign.desktop": "../../packaging/kde/rfirma-sign.desktop"
        },
        "desktopTemplate": "../../packaging/rfirma.desktop.hbs"
      },
      "rpm": {
        "files": {
          "/usr/lib/rfirma/librfirma_crypto.so": "../../rfirma-native-bridge/target/lib/rfirma/librfirma_crypto.so",
          "/usr/share/kio/servicemenus/rfirma-sign.desktop": "../../packaging/kde/rfirma-sign.desktop"
        },
        "desktopTemplate": "../../packaging/rfirma.desktop.hbs",
        "compression": {
          "type": "zstd",
          "level": 19
        }
      }
    }
  }
}
