{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "rfirma",
  "identifier": "me.sgomez.rfirma",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "pnpm exec vite",
    "beforeBuildCommand": ""
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost https://monitor.sgomez.me ws://localhost:*; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; frame-src rfirma-invoice://localhost http://rfirma-invoice.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "rpm"],
    "category": "Utility",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.png"],
    "linux": {
      "deb": {
        "files": {
          "/usr/lib/rfirma/librfirma_crypto.so": "../../rfirma-native-bridge/target/lib/rfirma/librfirma_crypto.so",
          "/usr/share/kio/servicemenus/rfirma-sign.desktop": "../../packaging/kde/rfirma-sign.desktop",
          "/usr/share/nautilus-python/extensions/rfirma-sign.py": "../../packaging/gnome/rfirma-sign.py",
          "/usr/share/doc/rfirma/licenses/heroicons-MIT.txt": "../../packaging/licenses/heroicons-MIT.txt",
          "/usr/share/doc/rfirma/licenses/EUPL-1.1.pdf": "../../packaging/licenses/EUPL-1.1.pdf",
          "/usr/share/doc/rfirma/licenses/EUPL-1.2.md": "../../LICENSE.md"
        },
        "depends": ["libpcsclite1", "libxslt1.1"],
        "recommends": ["python3-nautilus", "opensc", "pcscd"],
        "desktopTemplate": "../../packaging/rfirma.desktop.hbs"
      },
      "rpm": {
        "files": {
          "/usr/lib/rfirma/librfirma_crypto.so": "../../rfirma-native-bridge/target/lib/rfirma/librfirma_crypto.so",
          "/usr/share/kio/servicemenus/rfirma-sign.desktop": "../../packaging/kde/rfirma-sign.desktop",
          "/usr/share/nautilus-python/extensions/rfirma-sign.py": "../../packaging/gnome/rfirma-sign.py",
          "/usr/share/doc/rfirma/licenses/heroicons-MIT.txt": "../../packaging/licenses/heroicons-MIT.txt",
          "/usr/share/doc/rfirma/licenses/EUPL-1.1.pdf": "../../packaging/licenses/EUPL-1.1.pdf",
          "/usr/share/doc/rfirma/licenses/EUPL-1.2.md": "../../LICENSE.md"
        },
        "depends": ["libpcsclite.so.1()(64bit)", "libxslt.so.1()(64bit)"],
        "recommends": ["nautilus-python", "opensc", "pcsc-lite"],
        "desktopTemplate": "../../packaging/rfirma.desktop.hbs",
        "compression": {
          "type": "zstd",
          "level": 19
        }
      }
    }
  }
}
