        <span class="rf-label">Certificado</span>
        <sc-if value="{{ selCerrado }}" hint-placeholder-val="{{ true }}">
          <div role="button" tabindex="0" style="display:flex;align-items:center;gap:10px;min-height:52px;padding:6px 12px;border:1px solid var(--rf-border-strong);border-radius:var(--rf-radius-md);background:var(--rf-bg);cursor:pointer">
            <sc-if value="{{ buscando }}" hint-placeholder-val="{{ false }}">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" style="flex:none;color:var(--rf-text-muted)"><path d="M12 3a9 9 0 1 0 9 9"></path></svg>
              <span class="rf-text-muted" style="flex:1;font-size:14px">Buscando certificados…</span>
            </sc-if>
            <sc-if value="{{ sinElegir }}" hint-placeholder-val="{{ false }}">
              <span class="rf-text-muted" style="flex:1;font-size:14px">Elige un certificado</span>
            </sc-if>
            <sc-if value="{{ hayElegido }}" hint-placeholder-val="{{ true }}">
              <span class="rf-stack" style="gap:4px;flex:1;min-width:0">
                <span style="font-size:14px;font-weight:600;line-height:1.3;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">{{ selL1 }}</span>
                <span class="rf-body rf-text-muted" style="line-height:1.3;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">{{ selL2 }}</span>
              </span>
            </sc-if>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" style="flex:none;color:var(--rf-text-muted)"><path d="M6 9l6 6 6-6"></path></svg>
          </div>
