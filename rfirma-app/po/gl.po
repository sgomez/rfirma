msgid "sede.outcome.signedNote"
msgstr "rFirma non garda copia."

msgid "sede.outcome.savedTitle"
msgstr "Gardado"

msgid "sede.outcome.savedBody"
msgstr "O ficheiro que pedía {{origin}} xa está gardado onde o escolliches."

msgid "sede.outcome.savedBodyUnknownOrigin"
msgstr "O ficheiro xa está gardado onde o escolliches."

msgid "sede.outcome.loadedTitle"
msgstr "Cargado"

msgid "sede.outcome.loadedBody"
