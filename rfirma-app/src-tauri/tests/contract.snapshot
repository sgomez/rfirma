TIPOS QUE CRUZAN                          (<contexto>/adapters/views*.rs y orders.rs)
  Campos con el nombre que ve la ventana.

  pub struct Failure
      situation: String
      detail: String
      attemptsLeft: Option<u32>

  pub struct UrlHandlersView
      available: bool
      handlers: Vec<UrlHandlerView>
      current: Option<String>
      ours: String

  pub struct UrlHandlerView
      id: String
      name: String

  pub struct NewVersionView
      version: String

  pub struct RubricView
      base64: String
      width: u32
      height: u32

  pub struct RubricChoiceView
      rubric: Option<RubricView>
      failure: Option<Failure>

  pub struct DestinationView
      folder: String
      name: Option<String>
      writable: bool

  pub struct SignedDocumentView
      name: String
      folder: String
      sizeBytes: u64

  pub struct OpenedDocumentView
      id: String
      name: String
      modified: Option<u64>
      path: Option<String>

  pub struct DroppedDocumentView
      document: Option<OpenedDocumentView>
      alsoEntering: Vec<OpenedDocumentView>
      failure: Option<Failure>
      discarded: usize

  pub struct RecentDocumentView
      id: String
      name: String
      badge: Badge
      modified: Option<u64>
      lastUsed: u64
      available: bool
      placement: Option<PlacementView>

  pub enum SecretView   (serde: etiqueta "kind")
      NotNeeded
      TypedOnScreen { attemptsLeft: Option<u32> }
      TypedOnTheReaderKeypad

  pub struct CertificateView
      id: String
      label: String
      holderName: String
      idNumber: String
      issuer: String
      store: String
      status: StatusView
      remembered: bool

  pub struct VisibleFieldsOrder
      signerName: bool
      issuer: bool
      signedAt: bool
      reason: bool

  pub struct PlacementOrder
      page: u32
      pages: PageSet
      pageCount: u32
      mediaBox: [f64; 4]
      rotation: i32
      rect: [f64; 4]

  pub struct SigningOrder
      document: String
      certificate: String
      placement: Option<PlacementOrder>
      fields: VisibleFieldsOrder
      reason: String
      signedAt: String
      rubric: Option<String>
      language: String
      allowUnregisteredSignatures: bool

  pub enum StatusView   (serde: etiqueta "kind")
      Valid { notAfter: u64 }
      Expired { notAfter: u64 }
      NotYetValid { notBefore: u64 }
      Revoked { reason: String }
      Unreadable { detail: String }

  pub struct PlacementView
      rect: [f64; 4]
      pages: PageSet

  pub struct ConfigurationView
      language: String
      destination: String
      rememberVisibleSignature: bool
      rememberActivity: bool
      notifyNewVersion: bool
      theme: Theme
      offersTheOriginalFolder: bool
      trustNoticeSeen: bool
      askAboutUrlHandler: bool

  pub struct SiteErrandView
      origin: Option<String>
      stage: SiteStageView

  pub enum SignatureRoundView
      Sign
      Cosign

  pub enum SiteStageView   (serde: etiqueta "kind")
      Waiting
      AskingForConsent { certificates: Vec<CertificateView> }
      AskingToSign { document: String, round: SignatureRoundView, certificates: Vec<CertificateView>, unregisteredSignatures: bool }
      NoChannel { reason: NoChannelView }
      Outcome { outcome: SiteOutcomeView }
      NoCertificate { reason: NoCertificateView, owned: usize }

  pub enum NoChannelView
      ChannelNotOpened
      LocalCaMissing

  pub enum SiteOutcomeView   (serde: etiqueta "kind")
      Refused { situation: RefusalSituationView, detail: String }

  pub enum RefusalSituationView
      AppendedSignaturePage
      UnsupportedFilter
      UnsupportedProtocolVersion
      MissingFormat
      ErrandInFlight
      Unknown

  pub enum NoCertificateView
      None
      Excluded

  PRESTADOS DE OTROS MODULOS

  pub enum Badge   [documents/adapters/recents_store.rs]
      Signed
      Unsigned

  pub enum PageSet   [signing/domain/placement.rs]
      All
      Only(BTreeSet<u32>)

  pub enum Theme   [signing/application/configuration_memory.rs]
      System
      Light
      Dark

