---
import Comparison from "../components/Comparison.astro";
import Favicons from "../components/Favicons.astro";
import Footer from "../components/Footer.astro";
import Formats from "../components/Formats.astro";
import Hero from "../components/Hero.astro";
import HowToSign from "../components/HowToSign.astro";
import Install from "../components/Install.astro";
import Nav from "../components/Nav.astro";
import NoticeTop from "../components/NoticeTop.astro";
import Pillars from "../components/Pillars.astro";
import Transparency from "../components/Transparency.astro";
import { defaultLocale, localePath, locales, openGraphLocales, translator, type Locale } from "../i18n";
import "../styles/landing.css";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = translator(locale);
const canonical = new URL(localePath(locale), Astro.site);
const image = new URL("/og.png", Astro.site);
const description = t("meta.description");
const application = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "rFirma",
  description,
  url: canonical.href,
  inLanguage: locale,
  operatingSystem: "Linux, Windows, macOS",
  applicationCategory: "SecurityApplication",
  offers: { "@type": "Offer", price: "0", priceCurrency: "EUR" },
  downloadUrl: new URL("#instalacion", canonical).href,
  isBasedOn: { "@type": "SoftwareSourceCode", codeRepository: "https://github.com/sgomez/rfirma" },
};
const structuredData = JSON.stringify(application).replaceAll("<", "\\u003c");
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{t("meta.title")}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical.href} />
    <Favicons />
    {
      locales.map((other) => (
        <link rel="alternate" hreflang={other} href={new URL(localePath(other), Astro.site).href} />
      ))
    }
    <link rel="alternate" hreflang="x-default" href={new URL(localePath(defaultLocale), Astro.site).href} />
    <meta property="og:site_name" content="rFirma" />
    <meta property="og:title" content={t("meta.title")} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:locale" content={openGraphLocales[locale]} />
    {
      locales
        .filter((other) => other !== locale)
        .map((other) => <meta property="og:locale:alternate" content={openGraphLocales[other]} />)
    }
    <meta property="og:image" content={image.href} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={t("meta.image.alt")} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={t("meta.title")} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image.href} />
    <meta name="twitter:image:alt" content={t("meta.image.alt")} />
    <meta name="theme-color" content="#067781" />
    <script type="application/ld+json" set:html={structuredData} />
  </head>
  <body>
    <div class="rf-root landing" data-theme="light">
      <NoticeTop locale={locale} />
      <Nav locale={locale} />
      <main>
        <Hero locale={locale} />
        <Formats locale={locale} />
        <HowToSign locale={locale} />
        <Pillars locale={locale} />
        <Comparison locale={locale} />
        <Install locale={locale} />
        <Transparency locale={locale} />
      </main>
      <Footer locale={locale} />
    </div>

    <script>
      import { mountCopyButton } from "../scripts/copy-to-clipboard";
      import { mountGuidedDemo } from "../scripts/guided-demo";
      import { mountInstallTabs } from "../scripts/install-tabs";
      import { mountReveal } from "../scripts/reveal";
      import { mountWindowsDownload } from "../scripts/windows-download";

      const demo = document.querySelector<HTMLElement>(".demo");
      if (demo) {
        mountGuidedDemo(demo);
      }

      const tablist = document.querySelector<HTMLElement>("[data-install-tablist]");
      if (tablist) {
        mountInstallTabs(tablist, Array.from(document.querySelectorAll<HTMLElement>("[role='tabpanel']")));
      }

      for (const button of document.querySelectorAll<HTMLElement>("[data-copy-for]")) {
        const code = document.getElementById(button.dataset.copyFor ?? "");
        if (code) {
          mountCopyButton(button, code);
        }
      }

      const windowsDownload = document.querySelector<HTMLAnchorElement>("[data-windows-download]");
      if (windowsDownload) {
        void mountWindowsDownload(windowsDownload);
      }

      mountReveal(Array.from(document.querySelectorAll<HTMLElement>("[data-reveal]")));
    </script>
  </body>
</html>
