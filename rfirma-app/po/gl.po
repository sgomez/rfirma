msgstr "rFirma"

msgid "actions.cancel"
msgstr "Cancelar"

msgid "actions.close"
msgstr "Pechar"

msgid "actions.change"
msgstr "Cambiar"

msgid "actions.remove"
msgstr "Quitar"

msgid "actions.dismiss"
msgstr "Descartar"

msgid "actions.copy"
msgstr "Copiar"

msgid "actions.back"
msgstr "Volver"

