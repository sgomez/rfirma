      <sc-if value="{{ hayCofirma }}" hint-placeholder-val="{{ false }}">
        <div class="rf-stack" style="flex:none;border-radius:var(--rf-radius-md);{{ estiloBloqueCofirma }}">
          <div class="rf-row rf-gap-xs" style="min-height:36px;padding:0 2px 0 10px">
            <span style="display:flex;flex:none;height:18px;align-items:center"><sc-if value="{{ cabInfo }}" hint-placeholder-val="{{ true }}"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" style="flex:none"><circle cx="12" cy="12" r="9"/><path d="M12 11v5M12 8v.5"/></svg></sc-if><sc-if value="{{ cabAtencion }}" hint-placeholder-val="{{ false }}"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" style="flex:none"><path d="M12 4 2.5 20h19z"/><path d="M12 10v4M12 17v.5"/></svg></sc-if><sc-if value="{{ cabMal }}" hint-placeholder-val="{{ false }}"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" style="flex:none"><circle cx="12" cy="12" r="9"/><path d="M9 9l6 6M15 9l-6 6"/></svg></sc-if></span>
            <span class="rf-body" style="flex:1;min-width:0;font-size:13px;line-height:18px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis">Junto a {{ cuantasPrevias }}<sc-if value="{{ hayProblemas }}" hint-placeholder-val="{{ false }}"> · <strong>{{ problemas }}</strong></sc-if></span>
            <button type="button" class="rf-btn rf-btn--ghost" style="flex:none;min-height:28px;padding:0 6px;font-size:13px">Ver firmas →</button>
          </div>
          <sc-if value="{{ tuyaPie }}" hint-placeholder-val="{{ false }}">
            <div class="rf-row rf-gap-xs" style="padding:9px 12px;border-top:1px solid var(--rf-border-subtle);background:var(--rf-surface);border-radius:0 0 var(--rf-radius-md) var(--rf-radius-md)">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" style="flex:none"><circle cx="12" cy="8" r="4"/><path d="M4.5 20c1.2-4 4.2-6 7.5-6s6.3 2 7.5 6"/></svg>
              <span class="rf-body" style="flex:1;font-size:13px;font-weight:700">{{ textoTuya }}</span>
            </div>
          </sc-if>
        </div>
      </sc-if>
