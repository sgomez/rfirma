msgstr "Escolle no diálogo do sistema os ficheiros que queres enviar."

msgid "sede.outcome.signedTitle"
msgstr "Asinado e enviado"

msgid "sede.outcome.signedBody"
msgstr "A sinatura xa está en {{origin}}."

msgid "sede.outcome.signedBodyUnknownOrigin"
msgstr "A sinatura xa se enviou."

