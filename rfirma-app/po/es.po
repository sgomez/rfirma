msgid "sede.outcome.batchBodyUnknownOrigin"
msgid_plural "sede.outcome.batchBodyUnknownOrigin"
msgstr[0] "La firma del lote ya se ha enviado."
msgstr[1] "Las {{count}} firmas del lote ya se han enviado."
msgstr[2] "Las {{count}} firmas del lote ya se han enviado."

msgid "sede.outcome.cancelledTitle"
msgstr "Has cancelado la firma"

msgid "sede.outcome.refusedTitle"
msgstr "No se ha completado la petición"

msgid "sede.outcome.technicalDetail"
msgstr "Detalle técnico para la sede"

msgid "sede.outcome.reportHint"
msgstr "¿Te parece un fallo de rFirma?"

msgid "sede.outcome.autoClose"
msgstr "Se cerrará sola dentro de {{seconds}} s."

msgid "sede.oldWebClient.title"
msgstr "Esta página está desactualizada"

msgid "sede.oldWebClient.body"
msgstr ""
"La página usa una versión antigua de la pieza que habla con rFirma, y puede "
"tener errores o no ser segura. Pulsa Continuar para seguir; si algo falla, "
"avisa a quien mantiene la página."

msgid "sede.refusals.retry"
msgstr "Vuelve a la sede e inténtalo de nuevo."

msgid "sede.refusals.contactSite"
msgstr "Contacta con la sede para terminar el trámite."

msgid "sede.refusals.closeOther"
msgstr ""
"Cierra el otro trámite o la otra aplicación de firma y vuelve a intentarlo."

msgid "sede.refusals.otherCertificate"
msgstr "No se puede firmar con ese certificado. Vuelve a la sede y elige otro."

#. La causa de seguridad, antes de la acción: la persona no lee el detalle técnico.
msgid "sede.refusalCauses.sha1"
msgstr "La sede ha pedido una firma con SHA-1, que ya no es segura."

msgid "sede.refusalCauses.invoiceMultisignature"
msgstr ""
"La sede ha pedido añadir una segunda firma a una factura electrónica, que "
"solo admite una."

msgid "sede.refusalCauses.unsupportedCountersignature"
msgstr ""
"La sede ha pedido firmar sobre la firma de otra persona en un tipo de "
"documento que no lo permite."

msgid "sede.siteNotes.sha1"
msgstr "Pedid SHA256withRSA o superior."

msgid "sede.refusalHints.sha1"
msgstr ""
"Si confías en esta sede, puedes permitir SHA-1 en Preferencias → Firma y "
"volver a firmar desde la sede."

msgid "sede.siteNotes.invoiceMultisignature"
msgstr ""
"FacturaE no admite cofirma ni contrafirma; pedid una firma simple (sign)."

msgid "sede.siteNotes.unsupportedCountersignature"
msgstr ""
"La contrafirma solo existe en CAdES, CMS y XAdES; en otro formato, pedid una "
"cofirma (cosign)."

msgid "sede.noCertificate.noneTitle"
msgstr "No tienes ningún certificado"

msgid "sede.noCertificate.noneBody"
msgstr "Necesitas uno instalado para firmar en {{origin}}."

msgid "sede.noCertificate.noneBodyUnknownOrigin"
msgstr "Necesitas uno instalado para firmar."

msgid "sede.noCertificate.noneHint"
msgstr "Consíguelo en la FNMT o en tu comunidad autónoma."

msgid "sede.noCertificate.install"
msgstr "Instalar un certificado…"

#. La sede excluyó todos los certificados de la persona. Se dice cuántos tiene
#. —estado de su almacén— y nunca cuáles descartó la sede ni por qué.
msgid "sede.noCertificate.excludedTitle"
msgid_plural "sede.noCertificate.excludedTitle"
msgstr[0] "{{origin}} no acepta tu certificado"
msgstr[1] "{{origin}} no acepta ninguno de tus {{count}} certificados"
msgstr[2] "{{origin}} no acepta ninguno de tus {{count}} certificados"

msgid "sede.noCertificate.excludedTitleUnknownOrigin"
msgid_plural "sede.noCertificate.excludedTitleUnknownOrigin"
msgstr[0] "No se acepta tu certificado"
msgstr[1] "No se acepta ninguno de tus {{count}} certificados"
msgstr[2] "No se acepta ninguno de tus {{count}} certificados"

msgid "sede.noCertificate.terminalExcludedTitle"
msgid_plural "sede.noCertificate.terminalExcludedTitle"
msgstr[0] "Tu --filter no deja tu certificado"
msgstr[1] "Tu --filter no deja ninguno de tus {{count}} certificados"
msgstr[2] "Tu --filter no deja ninguno de tus {{count}} certificados"

msgid "sede.noCertificate.excludedBody"
msgstr "Instala otro certificado, o cierra y continúa desde la sede."
