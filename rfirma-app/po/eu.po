msgstr "Sinatuta"

msgid "badges.unsigned"
msgstr "Sinatu gabe"

msgid "badges.unavailable"
msgstr "Ez dago erabilgarri"

msgid "tray.dropZone"
msgstr "Arrastatu PDF bat edo sakatu irekitzeko"

msgid "tray.empty"
msgstr "Hemen agertuko dira sinatzen dituzun dokumentuak"

msgid "tray.recents"
msgstr "Azkenak"

msgid "tray.remove"
msgstr "Kendu zerrendatik"

msgid "viewer.dropZone"
msgstr "Arrastatu PDF bat edo sakatu irekitzeko"

msgid "viewer.dropZoneHint"
msgstr "Fitxategi-arakatzailea irekiko da"

msgid "viewer.privacy"
msgstr "PDFak soilik. Dokumentua ez da inoiz zure ordenagailutik ateratzen."

msgid "viewer.pageNumber"
msgstr "Orrialde-zenbakia"

#. {{total}} es el número de páginas del documento.
msgid "viewer.pageOf"
msgstr "{{total}}(e)tik"

msgid "viewer.firstPage"
msgstr "Lehen orrialdea"

msgid "viewer.previousPage"
msgstr "Aurreko orrialdea"

msgid "viewer.nextPage"
msgstr "Hurrengo orrialdea"

msgid "viewer.lastPage"
msgstr "Azken orrialdea"

msgid "viewer.zoomOut"
msgstr "Urrundu"

msgid "viewer.zoomIn"
msgstr "Hurbildu"

#. Rótulo del campo donde se teclea el porcentaje de zoom.
msgid "viewer.zoomLevel"
msgstr "Zoom-maila"

#. Botón: la hoja ocupa todo el ancho disponible.
msgid "viewer.fitWidth"
msgstr "Doitu zabalerara"

#. Botón: la página entera cabe en el visor.
msgid "viewer.fitPage"
msgstr "Doitu orrialdera"

#. Nombre accesible de la hoja del documento, que se enfoca para pasar de página.
msgid "viewer.sheet"
msgstr "Dokumentuaren orria"

msgid "viewer.signatureBox"
msgstr "Sinadura ikusgaiaren laukia"

msgid "viewer.dragHandle"
msgstr "Arrastatu kokatzeko"

msgid "viewer.outOfPage"
msgstr ""
"Laukia orrialdetik kanpo geratu da; beraz, zegoen lekuan jarraitzen du."

msgid "viewer.stamp.frozen"
msgstr "Zigilua izoztuta, laukia mugitzen duzun bitartean"

msgid "viewer.stamp.onDemand"
msgstr "Dokumentu handia: zigilua ez da bere kabuz birkalkulatzen"

msgid "viewer.stamp.show"
msgstr "Ikusi nola geratzen den"

msgid "viewer.stamp.composing"
msgstr "Zigilua osatzen, aukeratutako ziurtagiriarekin"

msgid "viewer.stamp.failed"
msgstr "Ezin izan da zigilua marraztu"

msgid "viewer.stamp.retry"
msgstr "Saiatu berriro"

msgid "panel.document.pages"
msgid_plural "panel.document.pages"
msgstr[0] "1 orrialde"
msgstr[1] "{{count}} orrialde"
msgstr[2] "{{count}} orrialde"

msgid "panel.coSignature"
msgid_plural "panel.coSignature"
msgstr[0] "1 sinadura du jada: zurea kosinadura izango da."
msgstr[1] "{{count}} sinadura ditu jada: zurea kosinadura izango da."
msgstr[2] "{{count}} sinadura ditu jada: zurea kosinadura izango da."

#. Rótulo del bloque con las tres opciones de en qué páginas se sella.
msgid "panel.placement.title"
msgstr "Kokapena"

msgid "panel.placement.single"
msgstr "1 orrialde soilik"

#. Pie de «Solo 1 página»: {{page}} es la página donde se colocó el recuadro.
msgid "panel.placement.singlePage"
msgstr "{{page}}. orrialdea"

#. Pie de «Solo 1 página» cuando todavía no hay recuadro en ninguna página.
msgid "panel.placement.singleUnplaced"
msgstr "oraindik kokatu gabe"

msgid "panel.placement.these"
msgstr "Orrialde hauek"

#. Nombre del campo donde se teclean las páginas, para quien usa lector de pantalla.
msgid "panel.placement.field"
msgstr "Zigilua zein orrialdetan jartzen den"

#. {{pages}} es el número de páginas del documento.
msgid "panel.placement.all"
msgstr "Orrialde guztiak ({{pages}})"

#. Botón que sella la página que se está mirando. Cara por omisión, con «Solo 1 página» o «Estas páginas».
msgid "panel.placement.seal"
msgstr "Zigilatu orrialde hau"

#. Botón que sella, con «Todas las páginas» activa: el conjunto ya está completo y falta el recuadro.
msgid "panel.placement.sealAll"
msgstr "Jarri zigilua hemen"

#. Botón que quita el sello de la página que se está mirando, cuando ya lo lleva.
msgid "panel.placement.unseal"
msgstr "Kendu zigilua"

#. {{pages}} son las primeras páginas del conjunto, ya escritas y separadas por comas.
msgid "panel.placement.echo"
msgstr "{{pages}} orrialdeetan zigilatuko da."

#. Igual que panel.placement.echo, con {{count}} páginas más que no se nombran.
msgid "panel.placement.echoMore"
msgid_plural "panel.placement.echoMore"
msgstr[0] "{{pages}} orrialdeetan eta beste batean zigilatuko da."
msgstr[1] "{{pages}} orrialdeetan eta beste {{count}}etan zigilatuko da."
msgstr[2] "{{pages}} orrialdeetan eta beste {{count}}etan zigilatuko da."

#. Se estampa un solo campo de firma con el recuadro replicado, no una firma por página.
msgid "panel.placement.replicated"
msgid_plural "panel.placement.replicated"
msgstr[0] "Lauki bera, leku berean eta tamaina berean, orrialde 1ean."
msgstr[1] ""
"Lauki bera, leku berean eta tamaina berean, {{count}} orrialdeetan: "
"errepikatutako sinadura-eremu bakarra da, ez {{count}} sinadura."
msgstr[2] ""
"Lauki bera, leku berean eta tamaina berean, {{count}} orrialdeetan: "
"errepikatutako sinadura-eremu bakarra da, ez {{count}} sinadura."

#. {{pageCount}} son las páginas del documento y {{page}} la más alta que se ha escrito.
msgid "panel.placement.errors.beyond"
msgstr ""
"Dokumentuak {{pageCount}} orrialde ditu eta {{page}}. orrialderaino idatzi "
"duzu."

#. {{entry}} es el rango tal y como se ha escrito, por ejemplo 3-1.
msgid "panel.placement.errors.reversed"
msgstr "«{{entry}}» alderantziz dago: lehen zenbakiak txikiena izan behar du."

msgid "panel.placement.errors.zero"
msgstr "Ez dago 0 orrialderik: lehena 1 da."

#. {{entry}} es lo que se ha escrito y no se entiende. El ejemplo del final no se traduce.
msgid "panel.placement.errors.malformed"
msgstr ""
"«{{entry}}» ez da ulertzen. Zenbakiak eta barrutiak komaz bereizita: "
"1,2-3,10-20."

#. El campo de páginas está vacío: no nombra ninguna, así que no se puede firmar.
msgid "panel.placement.errors.empty"
msgstr "Idatzi zein orrialdetan zigilatzen den: 1,2-3,10-20."

msgid "panel.certificate.title"
msgstr "Ziurtagiria"

msgid "panel.certificate.loading"
msgstr "Ziurtagiriak bilatzen…"

#. {{issuer}} es el nombre de la entidad emisora del certificado.
msgid "panel.certificate.issuer"
msgstr "Jaulkitzailea: {{issuer}}"

msgid "panel.certificate.choose"
msgstr "Aukeratu ziurtagiria"

msgid "panel.certificate.list"
msgstr "Ziurtagiri erabilgarriak"

msgid "panel.certificate.groups.available"
msgstr "Erabilgarriak"

msgid "panel.certificate.groups.unusable"
msgstr "Erabili ezinak"

msgid "panel.certificate.stores.card"
msgstr "Txartela"

msgid "panel.certificate.stores.firefox"
msgstr "Firefox"

msgid "panel.certificate.stores.chrome"
msgstr "Chrome"

#. Término del dominio: NSS es el almacén de certificados de Firefox y Chrome; no se traduce la sigla.
msgid "panel.certificate.stores.nssdb"
msgstr "NSS biltegia"

msgid "panel.certificate.stores.installed"
msgstr "rFirman instalatuta"

msgid "panel.certificate.retry"
msgstr "Bilatu berriro"

msgid "panel.certificate.otherModule"
msgstr "Beste modulu bat…"

msgid "panel.certificate.empty.title"
msgstr "Ez dugu ziurtagiririk aurkitu"

msgid "panel.certificate.empty.body"
msgstr ""
"Txartel bat erabiltzen baduzu, egiaztatu sartuta dagoela eta irakurgailua "
"konektatuta dagoela."

msgid "panel.certificate.failed.title"
msgstr "Ezin izan ditugu ziurtagiriak bilatu"

msgid "panel.certificate.failed.body"
msgstr ""
"Bilaketak amaitu aurretik huts egin du; beraz, ez dakigu bat ere badagoen."

#. {{date}} es la fecha de caducidad, ya formateada según el idioma.
msgid "panel.certificate.expired"
msgstr "Ziurtagiria {{date}}(e)an iraungi zen; beraz, ezin da harekin sinatu."

msgid "panel.certificate.notYetValid"
msgstr ""
"Ziurtagiria oraindik ez da indarrean sartu; beraz, ezin da harekin sinatu."

#. {{reason}} es el motivo de la revocación, tal como lo da el certificado.
msgid "panel.certificate.revoked"
msgstr ""
"Ziurtagiria errebokatuta dago ({{reason}}); beraz, ezin da harekin sinatu."

msgid "panel.certificate.unreadable"
msgstr "Ezin izan dugu ziurtagiri hau irakurri; beraz, ezin da harekin sinatu."

msgid "panel.visibleSignature.title"
msgstr "Sinadura ikusgaia"

msgid "panel.visibleSignature.toggle"
msgstr "Estanpatu sinadura-lauki bat dokumentuan"

msgid "panel.visibleSignature.content"
msgstr "Edukia"

msgid "panel.visibleSignature.fields.rubric"
msgstr "Errubrika"

msgid "panel.visibleSignature.fields.rubricDisabled"
msgstr "Aukeratu lehenik irudi bat"

msgid "panel.visibleSignature.fields.signerName"
msgstr "Sinatzailea"

msgid "panel.visibleSignature.fields.issuer"
msgstr "Jaulkitzailea"

msgid "panel.visibleSignature.fields.signedAt"
msgstr "Data"

msgid "panel.visibleSignature.fields.reason"
msgstr "Arrazoia"

