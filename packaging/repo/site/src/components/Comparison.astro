---
import { translator, type Locale } from "../i18n";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = translator(locale);
const rows = [
  "arch",
  "keys",
  "pin",
  "dnie",
  "store",
  "stores",
  "stamp",
  "sede",
  "ca",
  "lang",
  "privacy",
  "os",
  "updates",
  "desktop",
] as const;
---

<section id="comparativa" style="position:relative;background:#ffffff;overflow:clip">
  <div data-blob="cmp" aria-hidden="true"></div>
  <div
    style="position:relative;z-index:1;max-width:76rem;margin:0 auto;padding:clamp(56px,8vw,112px) clamp(16px,4vw,32px)"
  >
    <div data-reveal style="max-width:40rem;margin:0 auto;text-align:center">
      <span
        style="display:block;margin-bottom:12px;font-size:.8125rem;font-weight:700;letter-spacing:.14em;text-transform:uppercase;color:var(--rf-brand-text)"
        >{t("comparison.kicker")}</span
      >
      <h2
        style="margin:0;font-size:clamp(1.85rem,3.8vw,2.6rem);font-weight:800;line-height:1.15;letter-spacing:-.03em"
      >
        {t("comparison.title")}
      </h2>
    </div>
    <div data-reveal class="cmp-shell" style="margin-top:clamp(28px,4vw,48px)">
      <table class="cmp-table">
        <thead>
          <tr>
            <th scope="col" class="cmp-head cmp-head--aspect">{t("comparison.head.aspect")}</th>
            <th scope="col" class="cmp-head">{t("comparison.head.autofirma")}</th>
            <th scope="col" class="cmp-head cmp-head--rfirma">{t("comparison.head.rfirma")}</th>
          </tr>
        </thead>
        <tbody>
          {
            rows.map((row) => (
              <tr class="cmp-row">
                <th scope="row" class="cmp-label" set:html={t(`comparison.${row}.label` as const)} />
                <td
                  class="cmp-value"
                  data-head={t("comparison.head.autofirma")}
                  set:html={t(`comparison.${row}.autofirma` as const)}
                />
                <td
                  class="cmp-value cmp-value--rfirma"
                  data-head={t("comparison.head.rfirma")}
                  set:html={t(`comparison.${row}.rfirma` as const)}
                />
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
  </div>
</section>
