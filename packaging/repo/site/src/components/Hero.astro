---
import { Image } from "astro:assets";
import mainWindow from "../assets/rfirma-main-window.png";
import { translator, type Locale } from "../i18n";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = translator(locale);
const trust = ["hero.trust.oss", "hero.trust.keys", "hero.trust.formats", "hero.trust.langs"] as const;
---

<section style="position:relative;overflow:clip">
  <div data-blob="hero" aria-hidden="true"></div>
  <div data-blob="hero-soft" aria-hidden="true"></div>
  <div aria-hidden="true" style="position:absolute;inset:0;pointer-events:none;overflow:clip">
    <span data-orbit="1"></span><span data-orbit="2"></span><span data-orbit="3"></span>
    <span data-satellite="1" data-hide-sm
      ><svg
        width="18"
        height="18"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.8"
        stroke-linecap="round"
        stroke-linejoin="round"
        ><rect x="4" y="10" width="16" height="10" rx="2"></rect><path d="M8 10V7a4 4 0 0 1 8 0v3"
        ></path></svg
      ></span
    >
    <span data-satellite="2" data-hide-sm
      ><svg
        width="18"
        height="18"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.8"
        stroke-linecap="round"
        stroke-linejoin="round"
        ><path d="M4 18c3-9 6-11 7-7s-2 9-3 7 3-7 7-8 2 4 4 4 4-3 5-5"></path></svg
      ></span
    >
    <span data-satellite="3" data-hide-sm
      ><svg
        width="18"
        height="18"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.8"
        stroke-linecap="round"
        stroke-linejoin="round"
        ><path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z"></path><path
          d="M14 3v5h5"></path><path d="M9 15.5l2 2 4-4"></path></svg
      ></span
    >
  </div>

  <div
    style="position:relative;z-index:1;max-width:76rem;margin:0 auto;padding:clamp(48px,8vw,112px) clamp(16px,4vw,32px) clamp(64px,9vw,128px);display:grid;grid-template-columns:repeat(auto-fit,minmax(min(400px,100%),1fr));gap:clamp(40px,6vw,80px);align-items:center"
  >
    <div data-hero-copy style="display:flex;flex-direction:column;align-items:flex-start;gap:22px;max-width:34rem">
      <span
        style="font-size:.8125rem;font-weight:700;letter-spacing:.14em;text-transform:uppercase;color:var(--rf-brand-text)"
        >{t("hero.kicker")}</span
      >
      <h1
        style="margin:0;font-size:clamp(2.5rem,5.6vw,4.5rem);font-weight:800;line-height:1.02;letter-spacing:-.045em;text-wrap:balance"
      >
        {t("hero.title.line1")}<br /><span
          style="background:linear-gradient(90deg,#067781,#14b8a6 70%,#2dd4bf);-webkit-background-clip:text;background-clip:text;color:transparent"
          >{t("hero.title.line2")}</span
        >
      </h1>
      <p
        style="margin:0;font-size:clamp(1.0625rem,1.6vw,1.25rem);line-height:1.6;color:var(--rf-text-muted);text-wrap:pretty"
      >
        {t("hero.body")}
      </p>
      <div style="display:flex;flex-wrap:wrap;align-items:center;gap:18px;margin-top:6px">
        <a
          href="#instalacion"
          class="rf-btn rf-btn--pill"
          data-btn-brand
          style="text-decoration:none;padding:0 28px;min-height:50px;font-size:1rem">{t("hero.cta.primary")}</a
        >
        <a
          href="#firmar"
          style="display:inline-flex;align-items:center;gap:10px;text-decoration:none;font-weight:600;color:var(--rf-text)"
        >
          <span data-icon-round style="width:44px;height:44px"
            ><svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"
              ><path d="M8 5v14l11-7z"></path></svg
            ></span
          >
          <span>{t("hero.cta.secondary")}</span>
        </a>
      </div>
      <ul
        style="list-style:none;margin:10px 0 0;padding:0;display:flex;flex-wrap:wrap;gap:8px 22px;font-size:.875rem;color:var(--rf-text-muted)"
      >
        {
          trust.map((key) => (
            <li style="display:flex;align-items:center;gap:6px">
              <span style="width:6px;height:6px;border-radius:50%;background:var(--rf-brand)" />
              <span>{t(key)}</span>
            </li>
          ))
        }
      </ul>
    </div>

    <div data-hero-art style="position:relative;min-width:0;padding:24px 0 36px">
      <div
        data-tilt
        style="position:relative;border-radius:18px;background:#ffffff;border:1px solid rgba(255,255,255,.7);box-shadow:0 50px 90px -30px rgba(6,119,129,.45),0 20px 40px -20px rgba(0,0,0,.25);overflow:hidden"
      >
        <div
          style="height:34px;display:flex;align-items:center;gap:7px;padding:0 14px;background:#fafbfc;border-bottom:1px solid var(--rf-border-subtle)"
        >
          <span style="width:11px;height:11px;border-radius:50%;background:#e5e5e5"></span><span
            style="width:11px;height:11px;border-radius:50%;background:#e5e5e5"></span><span
            style="width:11px;height:11px;border-radius:50%;background:#e5e5e5"></span>
          <span style="margin-left:10px;font-size:.75rem;font-weight:600;color:var(--rf-text-muted)"
            >{t("hero.window.title")}</span
          >
        </div>
        <Image
          src={mainWindow}
          alt={t("hero.screenshot.alt")}
          loading="eager"
          style="width:100%;height:auto;display:block"
        />
      </div>

      <div
        data-float="1"
        data-hide-sm
        style="position:absolute;left:-36px;top:14%;display:flex;align-items:center;gap:12px;padding:12px 16px;background:#ffffff;border-radius:14px;box-shadow:0 24px 48px -16px rgba(6,119,129,.35),0 6px 16px -8px rgba(0,0,0,.15);max-width:250px"
      >
        <span data-icon-round
          ><svg
            width="20"
            height="20"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
            ><circle cx="12" cy="9" r="5"></circle><path d="M8.5 13.5 7 21l5-2.5L17 21l-1.5-7.5"
            ></path></svg
          ></span
        >
        <span style="min-width:0">
          <span
            style="display:block;font-size:.6875rem;font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:var(--rf-text-muted)"
            >{t("hero.card.cert.label")}</span
          >
          <span style="display:block;font-size:.8125rem;font-weight:700;line-height:1.3"
            >{t("hero.card.cert.value")}</span
          >
          <span style="display:block;font-size:.75rem;color:var(--rf-text-muted)"
            >{t("hero.card.cert.issuer")}</span
          >
        </span>
      </div>

      <div
        data-float="2"
        data-hide-sm
        style="position:absolute;right:-30px;top:8%;display:flex;flex-direction:column;align-items:center;gap:6px;padding:14px 16px;background:#ffffff;border-radius:14px;box-shadow:0 24px 48px -16px rgba(6,119,129,.35),0 6px 16px -8px rgba(0,0,0,.15);width:132px"
      >
        <svg width="64" height="64" viewBox="0 0 36 36" aria-hidden="true"
          ><circle cx="18" cy="18" r="15" fill="none" stroke="#e5e5e5" stroke-width="4"></circle><circle
            cx="18"
            cy="18"
            r="15"
            fill="none"
            stroke="url(#rfHeroRing)"
            stroke-width="4"
            stroke-linecap="round"
            stroke-dasharray="94.2"
            stroke-dashoffset="23.5"
            transform="rotate(-90 18 18)"></circle><defs
            ><linearGradient id="rfHeroRing" x1="0" y1="0" x2="1" y2="1"
              ><stop offset="0" stop-color="#067781"></stop><stop offset="1" stop-color="#2dd4bf"
              ></stop></linearGradient
            ></defs
          ><text x="18" y="21" text-anchor="middle" font-size="9" font-weight="800" fill="#000"
            >3/4</text
          ></svg
        >
        <span
          style="font-size:.6875rem;font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:var(--rf-text-muted)"
          >{t("hero.card.phase.label")}</span
        >
        <span style="font-size:.8125rem;font-weight:700">{t("hero.card.phase.value")}</span>
      </div>

      <div
        data-float="3"
        data-hide-sm
        style="position:absolute;right:-18px;bottom:6%;display:flex;align-items:center;gap:12px;padding:12px 16px;background:#ffffff;border-radius:14px;box-shadow:0 24px 48px -16px rgba(6,119,129,.35),0 6px 16px -8px rgba(0,0,0,.15);max-width:230px"
      >
        <span data-icon-round="amber"
          ><svg
            width="20"
            height="20"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
            ><path d="M4 18c3-9 6-11 7-7s-2 9-3 7 3-7 7-8 2 4 4 4 4-3 5-5"></path></svg
          ></span
        >
        <span style="min-width:0">
          <span
            style="display:block;font-size:.6875rem;font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:var(--rf-text-muted)"
            >{t("hero.card.stamp.label")}</span
          >
          <span style="display:block;font-size:.8125rem;font-weight:700;line-height:1.3"
            >{t("hero.card.stamp.value")}</span
          >
        </span>
      </div>

      <div
        data-float="4"
        data-hide-sm
        style="position:absolute;left:6%;bottom:-6px;display:flex;align-items:center;gap:10px;padding:10px 14px;background:#ffffff;border-radius:999px;box-shadow:0 18px 40px -16px rgba(6,119,129,.35),0 6px 16px -8px rgba(0,0,0,.15)"
      >
        <span data-icon-round="soft" style="width:32px;height:32px"
          ><svg
            width="16"
            height="16"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"><path d="M4 12.5 9.5 18 20 6"></path></svg
          ></span
        >
        <span style="font-size:.8125rem;font-weight:700">{t("hero.card.format.value")}</span>
      </div>
    </div>
  </div>
</section>
