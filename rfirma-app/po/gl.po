msgid "errors.technicalDetail"
msgstr "Detalle técnico"

msgid "errors.help"
msgstr "Comentarios e axuda"

msgid "errors.reload"
msgstr "Recargar a fiestra"

#. El botón que copia el detalle técnico crudo del error de firma.
msgid "errors.copyDetail"
msgstr "Copiar detalle"

#. Añade la tranquilidad de que nada se ha guardado, junto a un fallo ya clasificado.
msgid "errors.documentUnchanged"
msgstr "O documento segue igual: non se gardou nada."

#. El título fijo del error de firma (docs/design/panel-de-firma.md § Estados
#. → Error al firmar); la situación clasificada baja a ser la causa.
msgid "errors.signingFailedTitle"
msgstr "Non se puido asinar"

msgid "errors.situations.unknown.title"
msgstr "Non se puido completar a operación"

msgid "errors.situations.unknown.body"
msgstr ""
"Téntao de novo. Se segue a ocorrer, achega o detalle técnico ao informe do "
"fallo."

msgid "errors.situations.handlerNotAvailable.title"
msgstr "Non se pode cambiar quen atende as ligazóns"

msgid "errors.situations.handlerNotAvailable.body"
msgstr ""
"Esta versión de rFirma non pode escribir esa escolla: cámbiase nos axustes "
"do escritorio."

msgid "errors.situations.handlerListUnreadable.title"
msgstr "Non se puido ler a escolla do escritorio"

msgid "errors.situations.handlerListUnreadable.body"
msgstr ""
"O ficheiro onde o escritorio a garda non se puido ler, así que se deixou "
"como estaba."

msgid "errors.situations.handlerListUnwritable.title"
msgstr "Non se puido gardar quen atende as ligazóns"

msgid "errors.situations.handlerListUnwritable.body"
msgstr "O ficheiro onde o escritorio a garda non se puido escribir."

msgid "errors.situations.notAnAcceptedImage.title"
msgstr "Esa imaxe non vale como rúbrica"

msgid "errors.situations.notAnAcceptedImage.body"
msgstr "A rúbrica ten que ser un PNG ou un JPEG."

msgid "errors.situations.damagedImage.title"
msgstr "Non puidemos abrir a imaxe"

msgid "errors.situations.damagedImage.body"
msgstr ""
"O ficheiro é un PNG ou un JPEG, pero está danado. Proba con outra copia."

msgid "errors.situations.imageTooLarge.title"
msgstr "A imaxe é demasiado grande"

msgid "errors.situations.imageTooLarge.body"
msgstr "Escolle unha imaxe máis pequena ou gárdaa con menos resolución."

msgid "errors.situations.sourceUnreadable.title"
msgstr "Non puidemos ler o ficheiro que escolliches"

msgid "errors.situations.sourceUnreadable.body"
msgstr "Comproba que segue onde estaba e volve escollelo."

msgid "errors.situations.storeUnwritable.title"
msgstr "Non puidemos gardar a túa rúbrica"

msgid "errors.situations.storeUnwritable.body"
msgstr ""
"Volve escoller a imaxe. Se segue a ocorrer, achega o detalle técnico ao "
"informe do fallo."

msgid "errors.situations.storeUnreadable.title"
msgstr "Non puidemos ler a túa rúbrica gardada"

msgid "errors.situations.storeUnreadable.body"
msgstr "Volve escoller a imaxe para substituíla."

msgid "errors.situations.incorrectPin.title"
msgstr "O PIN non é correcto"

msgid "errors.situations.incorrectPin.body"
msgstr "Volve introducilo. A tarxeta bloquéase tras varios intentos fallidos."

msgid "errors.situations.pinLocked.title"
msgstr "A tarxeta está bloqueada"

msgid "errors.situations.pinLocked.body"
msgstr ""
"Bloqueouse tras demasiados intentos fallidos co PIN. Desbloquéaa co seu PUK "
"antes de volver asinar."

msgid "errors.situations.tokenAbsent.title"
msgstr "Non atopamos a tarxeta"

msgid "errors.situations.tokenAbsent.body"
msgstr ""
"Comproba que segue inserida e que o lector está conectado, e téntao de novo."

msgid "errors.situations.expiredSession.title"
msgstr "A sesión coa tarxeta caducou"

msgid "errors.situations.expiredSession.body"
msgstr ""
"Téntao de novo: abrirase unha sesión nova e pedirémosche o PIN outra vez."

msgid "errors.situations.moduleNotFound.title"
msgstr "Non puidemos cargar o módulo da tarxeta"

msgid "errors.situations.moduleNotFound.body"
msgstr "Comproba que o módulo PKCS#11 está onde dixeches, ou escolle outro."

msgid "errors.situations.certificateNotFound.title"
msgstr "O certificado xa non está na tarxeta"

msgid "errors.situations.certificateNotFound.body"
msgstr "Volve buscar os certificados e escolle un dos que haxa."

msgid "errors.situations.certificateExpired.title"
msgstr "O certificado caducou"

msgid "errors.situations.certificateExpired.body"
msgstr ""
"Un certificado caducado non serve para asinar. Renóvao coa súa emisora e "
"téntao de novo."

msgid "errors.situations.certificateNotYetValid.title"
msgstr "O certificado aínda non está en vigor"

msgid "errors.situations.certificateNotYetValid.body"
msgstr ""
"Aínda non comezou o seu período de validez, así que non serve para asinar."

msgid "errors.situations.certificateRevoked.title"
msgstr "O certificado está revogado"

msgid "errors.situations.certificateRevoked.body"
msgstr ""
"A súa emisora revogouno, así que non serve para asinar. Necesitas un novo."

msgid "errors.situations.pkcs12Unreadable.title"
msgstr "Non se puido abrir o certificado"

msgid "errors.situations.pkcs12Unreadable.body"
msgstr "Comproba o contrasinal do ficheiro."

#. Un solo renglon a proposito (ID-211): no lleva cuerpo debajo, y por eso no
#. hay msgid "errors.situations.keyNotRsa.body".
msgid "errors.situations.keyNotRsa.title"
msgstr "Ese certificado non é compatible con rFirma"

msgid "errors.situations.mechanismNotOffered.title"
msgstr "O token non admite ese algoritmo de sinatura"

msgid "errors.situations.mechanismNotOffered.body"
msgstr "Proba con outro certificado ou pídelle á sede que use SHA-256 con RSA."

msgid "errors.situations.certificateUnreadable.title"
msgstr "Non puidemos ler o certificado"

msgid "errors.situations.certificateUnreadable.body"
msgstr ""
"O que hai na tarxeta non é un certificado que saibamos ler. Proba con outro."

msgid "errors.situations.notAPdf.title"
msgstr "Ese ficheiro non é un PDF"

msgid "errors.situations.notAPdf.body"
msgstr "rFirma asina PDF. Escolle un documento PDF e téntao de novo."

msgid "errors.situations.documentEncrypted.title"
msgstr "O PDF está protexido"

msgid "errors.situations.documentEncrypted.body"
msgstr ""
"Está cifrado ou ten os permisos restrinxidos, así que non se pode asinar. "
"Ábreo co seu contrasinal, gárdao sen protección e téntao de novo."

msgid "errors.situations.documentCertified.title"
msgstr "O PDF está certificado"

msgid "errors.situations.documentCertified.body"
msgstr ""
"O seu autor asinouno prohibindo os cambios, así que engadir unha sinatura "
"invalidaría a súa. Pídelle unha copia sen certificar."

msgid "errors.situations.documentUnreadable.title"
msgstr "Non puidemos ler o documento"

msgid "errors.situations.documentUnreadable.body"
msgstr "Comproba que segue onde estaba e volve abrilo."

msgid "errors.situations.droppedFileUnreadable.title"
msgstr "Non puidemos ler o ficheiro que soltaches"

msgid "errors.situations.droppedFileUnreadable.body"
msgstr ""
"Arrastrar non nos dá permiso para ler de calquera cartafol. Ábreo co botón "
"de abrir, que si nolo dá."

msgid "errors.situations.droppedSomeDiscarded.title"
msgstr "Algúns ficheiros non se engadiron"

msgid "errors.situations.droppedSomeDiscarded.body"
msgstr ""
"Os demais PDF que soltaches abríronse en lapelas. Os que non eran PDF non se "
"engadiron."

msgid "errors.situations.boxOutOfPage.title"
msgstr "O cadro sae da páxina"

msgid "errors.situations.boxOutOfPage.body"
msgstr ""
"Arrástrao dentro da páxina e volve asinar. Se o deixásemos así, quedaría "
"recortado no PDF sen avisar."

msgid "errors.situations.pageOutOfDocument.title"
msgstr "O documento non chega a esa páxina"

msgid "errors.situations.pageOutOfDocument.body"
msgstr ""
"Escolle unha páxina que exista no documento e volve asinar. Se o deixásemos "
"así, a sinatura visible acabaría na última páxina sen avisar."

msgid "errors.situations.sealMismatch.title"
msgstr "A sinatura interrompeuse a medias"

msgid "errors.situations.sealMismatch.body"
msgstr ""
"O que preparamos ao comezar e o que recibimos ao rematar non coinciden, así "
"que paramos antes de escribir nada. Volve asinar o documento."

msgid "errors.situations.bridgeFailed.title"
msgstr "Non puidemos preparar a sinatura"

msgid "errors.situations.bridgeFailed.body"
msgstr ""
"Fallou o compoñente que arma o PDF asinado. Téntao de novo e, se segue a "
"ocorrer, achega o detalle técnico ao informe do fallo."

msgid "errors.situations.renderFailed.title"
msgstr "Esta pantalla deixou de funcionar"

msgid "errors.situations.renderFailed.body"
msgstr ""
"Recarga a fiestra para continuar. Se segue a ocorrer, achega o detalle "
"técnico ao informe do fallo."

msgid "errors.situations.folderMissing.title"
msgstr "O cartafol de destino xa non está"

msgid "errors.situations.folderMissing.body"
msgstr ""
"Non o creamos por ti: se o creásemos, o documento parecería gardado e non o "
"estaría. Volve crealo ou escolle outro en Preferencias."

msgid "errors.situations.notAFolder.title"
msgstr "O destino non é un cartafol"

msgid "errors.situations.notAFolder.body"
msgstr ""
"Hai un ficheiro con ese nome onde esperabamos un cartafol. Escolle outro "
"destino en Preferencias."

msgid "errors.situations.folderUnreadable.title"
msgstr "Non puidemos consultar o cartafol de destino"

msgid "errors.situations.folderUnreadable.body"
msgstr ""
"Pode ser cousa dos permisos ou dunha unidade que non responde. Escolle outro "
"destino en Preferencias."

msgid "errors.situations.folderUnwritable.title"
msgstr "Non puidemos gardar o documento asinado"

msgid "errors.situations.folderUnwritable.body"
msgstr ""
"A sinatura saíu ben, pero o ficheiro non se puido escribir no cartafol de "
"destino. Escolle outro en Preferencias e volve asinar."

msgid "errors.situations.noFreeName.title"
msgstr "Xa hai demasiados documentos con ese nome"

msgid "errors.situations.noFreeName.body"
msgstr ""
"Para non machacar ningún, paramos. Move ou renomea os anteriores e volve "
"asinar."

msgid "errors.situations.settingNotSaved.title"
msgstr "Non puidemos gardar o axuste"

msgid "errors.situations.settingNotSaved.body"
msgstr ""
"Volvemos ao valor anterior, que é o que segue gardado. Téntao de novo e, se "
"segue a ocorrer, achega o detalle técnico ao informe do fallo."

msgid "errors.situations.activityNotForgotten.title"
msgstr "Non puidemos baleirar a lista"

msgid "errors.situations.activityNotForgotten.body"
msgstr ""
"Os documentos recentes e o certificado seguen gardados. Téntao de novo e, se "
"segue a ocorrer, achega o detalle técnico ao informe do fallo."

#. Se enseña en un diálogo nativo antes de que exista ventana; no la lee i18next.
msgid "errors.startup.homeUnknown"
msgstr "rFirma non sabe cal é o teu cartafol persoal e non pode arrincar."

#. Se enseña en un diálogo nativo antes de que exista ventana; no la lee i18next.
msgid "errors.startup.scratchFolderUnusable"
msgstr ""
"rFirma non puido crear o cartafol de paso que necesita e non pode arrincar."

#. Se enseña en un diálogo nativo antes de que exista ventana; no la lee i18next.
msgid "errors.startup.windowUnavailable"
msgstr "rFirma non puido abrir a xanela e non pode arrincar."

#. Nombre accesible de la región para lectores de pantalla, no un título visible.
msgid "window.viewer"
msgstr "Visor do documento"

#. Nombre accesible de la región para lectores de pantalla, no un título visible.
msgid "window.panel"
msgstr "Panel de sinatura"

#. {{version}} es la versión publicada, p. ej. 0.4.1.
msgid "notifications.newVersion.message"
msgstr "Hai unha versión nova de rFirma: {{version}}"

#. Lleva a «Acerca de», donde están las órdenes de alta del repositorio.
msgid "notifications.newVersion.action"
msgstr "Como actualizar"

msgid "header.menu"
msgstr "Menú"

msgid "header.status"
msgstr "Estado de rFirma"

msgid "header.statusAttention"
msgstr "Require atención"

msgid "header.preferences"
msgstr "Preferencias…"

msgid "header.help"
msgstr "Comentarios e axuda"

msgid "header.about"
msgstr "Acerca de rFirma"

msgid "badges.signed"
msgstr "Asinado"

#. Nombre accesible de la tira de pestañas, no un título visible.
msgid "tabs.label"
msgstr "Documentos abertos"

#. Nombre del botón «+» de la tira de pestañas.
msgid "tabs.open"
msgstr "Abrir un PDF"

msgid "tabs.previous"
msgstr "Pestanas anteriores"

msgid "tabs.next"
msgstr "Pestanas seguintes"

#. {{name}} es el nombre del fichero de la pestaña.
msgid "tabs.close"
msgstr "Pechar {{name}}"

#. Título de la pestaña de otro documento mientras una firma está en curso.
msgid "tabs.lockedWhileSigning"
msgstr "Non se pode cambiar de documento mentres se asina."

msgid "tabs.openPdf"
msgstr "Abrir un PDF…"

msgid "recents.heading"
msgstr "Recentes"

msgid "recents.clear"
msgstr "Baleirar a lista"

msgid "recents.open"
msgstr "Aberto"

msgid "recents.goToTab"
msgstr "Ir á súa pestana"

msgid "recents.missing"
msgstr "Non se atopa"

msgid "recents.today"
msgstr "hoxe"

msgid "recents.yesterday"
msgstr "onte"

msgid "viewer.dropZone"
msgstr "Arrastra un PDF ou preme para abrilo"

msgid "viewer.dropZoneHint"
msgstr "Non sae do teu ordenador"

msgid "viewer.pageNumber"
msgstr "Número de páxina"

#. {{total}} es el número de páginas del documento.
msgid "viewer.pageOf"
msgstr "de {{total}}"

msgid "viewer.firstPage"
msgstr "Primeira páxina"

msgid "viewer.previousPage"
msgstr "Páxina anterior"

msgid "viewer.nextPage"
msgstr "Páxina seguinte"

msgid "viewer.lastPage"
msgstr "Última páxina"

msgid "viewer.zoomOut"
msgstr "Afastar"

msgid "viewer.zoomIn"
msgstr "Achegar"

#. Rótulo del campo donde se teclea el porcentaje de zoom.
msgid "viewer.zoomLevel"
msgstr "Nivel de zoom"

#. Botón: la hoja ocupa todo el ancho disponible.
msgid "viewer.fitWidth"
msgstr "Axustar ao ancho"

#. Botón: la página entera cabe en el visor.
msgid "viewer.fitPage"
msgstr "Axustar á páxina"

#. Nombre accesible de la hoja del documento, que se enfoca para pasar de página.
msgid "viewer.sheet"
msgstr "Folla do documento"

msgid "viewer.signatureBox"
msgstr "Cadro da sinatura visible"

msgid "viewer.dragHandle"
msgstr "Arrastra para colocar"

msgid "viewer.outOfPage"
msgstr "O cadro quedou fóra da páxina, así que segue onde estaba."

msgid "viewer.stamp.frozen"
msgstr "Sinatura visible conxelada mentres moves o cadro"

msgid "viewer.stamp.onDemand"
msgstr "Documento grande: a sinatura visible non se recalcula soa"

msgid "viewer.stamp.show"
msgstr "Ver como queda"

msgid "viewer.stamp.composing"
msgstr "Compoñendo a sinatura visible co certificado escollido"

msgid "viewer.stamp.failed"
msgstr "Non se puido debuxar a sinatura visible"

msgid "viewer.stamp.retry"
msgstr "Tentar de novo"

msgid "panel.document.pages"
msgid_plural "panel.document.pages"
msgstr[0] "1 páxina"
msgstr[1] "{{count}} páxinas"
msgstr[2] "{{count}} páxinas"

msgid "panel.coSignature"
msgid_plural "panel.coSignature"
msgstr[0] "Asinarás xunto a 1 sinatura anterior"
msgstr[1] "Asinarás xunto a {{count}} sinaturas anteriores"
msgstr[2] "Asinarás xunto a {{count}} sinaturas anteriores"

#. Etiqueta accesible del aviso de firmas previas cuando está plegado.
msgid "panel.previousSignatures.show"
msgstr "Ver sinaturas anteriores"

#. Etiqueta accesible del aviso de firmas previas cuando está desplegado.
msgid "panel.previousSignatures.hide"
msgstr "Ocultar sinaturas anteriores"

#. Franja al pie del aviso de firmas previas: ya firmaste con el certificado elegido.
msgid "panel.previousSignatures.sameCertificate"
msgstr "Xa o asinaches ti con este certificado"

#. Franja al pie del aviso de firmas previas: ya firmaste, pero con otro certificado tuyo.
msgid "panel.previousSignatures.otherCertificate"
msgstr "Xa o asinaches ti, con outro certificado teu"

#. Coletilla de la línea plegada del aviso de firmas previas, en su propia línea fija.
msgid "panel.previousSignatures.warnings"
msgid_plural "panel.previousSignatures.warnings"
msgstr[0] "1 aviso"
msgstr[1] "{{count}} avisos"
msgstr[2] "{{count}} avisos"

#. En la fila de la última firma previa, cuando el backend marca el documento como cambiado.
msgid "panel.previousSignatures.changedAfterSignature"
msgstr "O documento cambiou despois desta sinatura"

#. Veredicto de una fila del aviso de firmas previas: la firma se sostiene.
msgid "panel.previousSignatures.status.valid"
msgstr "Válida"

#. Veredicto de una fila del aviso de firmas previas: el certificado con el que se firmó ya caducó.
msgid "panel.previousSignatures.status.certificateExpired"
msgstr "Certificado caducado"

#. Veredicto de una fila del aviso de firmas previas: el certificado todavía no era válido al firmar.
msgid "panel.previousSignatures.status.certificateNotYetValid"
msgstr "Certificado aínda non válido"

#. Veredicto de una fila del aviso de firmas previas: la firma no corresponde, está dañada o el PDF certificado no admitía más.
msgid "panel.previousSignatures.status.broken"
msgstr "Sinatura rota"

#. Veredicto de una fila del aviso de firmas previas: formato no reconocido.
msgid "panel.previousSignatures.status.unverifiable"
msgstr "Non se pode validar"

#. Veredicto de una fila del aviso de firmas previas: firma de perfil longevo con el certificado ya caducado.
msgid "panel.previousSignatures.status.notFullyChecked"
msgstr "Non se puido comprobar do todo"

#. Motivo bajo el veredicto «Certificado caducado».
msgid "panel.previousSignatures.reason.certificateExpired"
msgstr "O certificado xa caducou"

#. Motivo bajo el veredicto «Certificado aún no válido».
msgid "panel.previousSignatures.reason.certificateNotYetValid"
msgstr "O certificado aínda non é válido"

#. Motivo bajo el veredicto «No se puede validar».
msgid "panel.previousSignatures.reason.unverifiable"
msgstr "Formato non recoñecido"

#. Motivo bajo el veredicto «No se ha podido comprobar del todo».
msgid "panel.previousSignatures.reason.notFullyChecked"
msgstr "Sinatura de longa duración: rFirma non comproba este tipo de sinatura"

#. Motivo bajo el veredicto «Firma rota»: no corresponde con los datos del documento.
msgid "panel.previousSignatures.reason.brokenDataMismatch"
msgstr "Non se corresponde cos datos do documento"

#. Motivo bajo el veredicto «Firma rota»: está dañada.
msgid "panel.previousSignatures.reason.brokenCorrupted"
msgstr "Está danada"

#. Motivo bajo el veredicto «Firma rota»: el PDF estaba certificado y no admitía más firmas.
msgid "panel.previousSignatures.reason.brokenCertifiedRevision"
msgstr "O PDF estaba certificado e non admitía máis sinaturas"

#. Nombre accesible del segmentado que elige en qué páginas va la firma visible.
msgid "panel.placement.title"
msgstr "En que páxinas"

#. Segmento: la firma visible en una sola página.
msgid "panel.placement.single"
msgstr "Unha páxina"

#. Bajo «Una página»: {{page}} es la página donde está el recuadro.
msgid "panel.placement.singlePage"
msgstr "Na páxina {{page}}"

#. Segmento: la firma visible en las páginas que se escriben en el campo.
msgid "panel.placement.these"
msgstr "Varias"

#. Nombre del campo donde se teclean las páginas, para quien usa lector de pantalla.
msgid "panel.placement.field"
msgstr "Páxinas da sinatura visible"

#. Segmento: la firma visible en todas las páginas del documento.
msgid "panel.placement.all"
msgstr "Todas"

#. Botón que pone la firma visible en la página que se está mirando, con «Una página» o «Varias».
msgid "panel.placement.seal"
msgstr "Poñela aquí"

#. Botón que quita la firma visible de la página que se está mirando, cuando ya la lleva.
msgid "panel.placement.unseal"
msgstr "Quitala de aquí"

#. {{count}} son las páginas del documento; se ha escrito una que no existe.
msgid "panel.placement.errors.beyond"
msgid_plural "panel.placement.errors.beyond"
msgstr[0] "Só hai 1 páxina"
msgstr[1] "Só hai {{count}} páxinas"
msgstr[2] "Só hai {{count}} páxinas"

#. {{entry}} es el rango tal y como se ha escrito, por ejemplo 3-1.
msgid "panel.placement.errors.reversed"
msgstr "«{{entry}}» vai ao revés"

msgid "panel.placement.errors.zero"
msgstr "Non hai páxina 0"

#. Lo escrito no se entiende: las páginas y los rangos van separados por comas.
msgid "panel.placement.errors.malformed"
msgstr "Separa as páxinas con comas"

#. El campo de páginas está vacío: no nombra ninguna, así que no se puede firmar.
msgid "panel.placement.errors.empty"
msgstr "Escribe as páxinas"

msgid "panel.certificate.title"
msgstr "Certificado"

msgid "panel.certificate.changeTitle"
msgstr "Elixir outro certificado"

msgid "panel.certificate.loading"
msgstr "Buscando certificados…"

#. {{issuer}} es el nombre de la entidad emisora del certificado.
msgid "panel.certificate.issuer"
msgstr "Emitido por {{issuer}}"

msgid "panel.certificate.choose"
msgstr "Escoller certificado"

msgid "panel.certificate.list"
msgstr "Certificados dispoñibles"

msgid "panel.certificate.groups.available"
msgstr "Dispoñibles"

msgid "panel.certificate.groups.unusable"
msgstr "Non utilizables"

msgid "panel.certificate.stores.card"
msgstr "Tarxeta"

msgid "panel.certificate.stores.firefox"
msgstr "Firefox"

msgid "panel.certificate.stores.chrome"
msgstr "Chrome"

#. Término del dominio: NSS es el almacén de certificados de Firefox y Chrome; no se traduce la sigla.
msgid "panel.certificate.stores.nssdb"
msgstr "Almacén NSS"

msgid "panel.certificate.stores.installed"
msgstr "Instalado en rFirma"

msgid "panel.certificate.retry"
msgstr "Volver buscar"

#. {{date}} es «mes/año» de caducidad, ya formateado, para la segunda línea de
#. la fila del botón partido.
msgid "panel.certificate.expiresIn"
msgstr "Caduca en {{date}}"

