msgstr[1] "Enviáronse {{count}} ficheiros."
msgstr[2] "Enviáronse {{count}} ficheiros."

msgid "sede.outcome.batchTitle"
msgstr "Lote asinado e enviado"

msgid "sede.outcome.batchBody"
