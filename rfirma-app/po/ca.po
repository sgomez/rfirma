msgstr "Menú"

msgid "header.status"
msgstr "Estat de rFirma"

msgid "header.statusAttention"
msgstr "Requereix atenció"

msgid "header.preferences"
msgstr "Preferències…"

msgid "header.help"
msgstr "Comentaris i ajuda"

msgid "header.about"
msgstr "Quant a rFirma"

msgid "badges.signed"
msgstr "Signat"

