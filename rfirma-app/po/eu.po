msgid "errors.technicalDetail"
msgstr "Xehetasun teknikoa"

msgid "errors.situations.unknown.title"
msgstr "Ezin izan da eragiketa osatu"

msgid "errors.situations.unknown.body"
msgstr ""
"Saiatu berriro. Gertatzen jarraitzen badu, erantsi xehetasun teknikoa "
"akatsaren txostenari."

msgid "errors.situations.handlerNotAvailable.title"
msgstr "Ezin da aldatu estekak nork artatzen dituen"

msgid "errors.situations.handlerNotAvailable.body"
msgstr ""
"rFirmaren bertsio honek ezin du aukera hori idatzi: mahaigainaren "
"ezarpenetan aldatzen da."

msgid "errors.situations.handlerListUnreadable.title"
msgstr "Ezin izan da mahaigainaren aukera irakurri"

msgid "errors.situations.handlerListUnreadable.body"
msgstr ""
"Mahaigainak aukera hori gordetzen duen fitxategia ezin izan da irakurri; "
"beraz, zegoen bezala utzi da."

msgid "errors.situations.handlerListUnwritable.title"
msgstr "Ezin izan da gorde estekak nork artatzen dituen"

msgid "errors.situations.handlerListUnwritable.body"
msgstr "Mahaigainak aukera hori gordetzen duen fitxategia ezin izan da idatzi."

msgid "errors.situations.notAnAcceptedImage.title"
msgstr "Irudi horrek ez du errubrikarako balio"

msgid "errors.situations.notAnAcceptedImage.body"
msgstr "Errubrikak PNG edo JPEG izan behar du."

msgid "errors.situations.damagedImage.title"
msgstr "Ezin izan dugu irudia ireki"

msgid "errors.situations.damagedImage.body"
msgstr ""
"Fitxategia PNG edo JPEG bat da, baina hondatuta dago. Probatu beste kopia "
"batekin."

msgid "errors.situations.imageTooLarge.title"
msgstr "Irudia handiegia da"

msgid "errors.situations.imageTooLarge.body"
msgstr "Aukeratu irudi txikiago bat edo gorde ezazu bereizmen txikiagoarekin."

msgid "errors.situations.sourceUnreadable.title"
msgstr "Ezin izan dugu aukeratu duzun fitxategia irakurri"

msgid "errors.situations.sourceUnreadable.body"
msgstr "Egiaztatu zegoen lekuan jarraitzen duela eta aukeratu berriro."

msgid "errors.situations.storeUnwritable.title"
msgstr "Ezin izan dugu zure errubrika gorde"

msgid "errors.situations.storeUnwritable.body"
msgstr ""
"Aukeratu irudia berriro. Gertatzen jarraitzen badu, erantsi xehetasun "
"teknikoa akatsaren txostenari."

msgid "errors.situations.storeUnreadable.title"
msgstr "Ezin izan dugu gordetako zure errubrika irakurri"

msgid "errors.situations.storeUnreadable.body"
msgstr "Aukeratu irudia berriro, ordezteko."

msgid "errors.situations.incorrectPin.title"
msgstr "PINa ez da zuzena"

msgid "errors.situations.incorrectPin.body"
msgstr ""
"Sartu berriro. Txartela blokeatu egiten da hainbat saiakera huts eginda."

msgid "errors.situations.pinLocked.title"
msgstr "Txartela blokeatuta dago"

msgid "errors.situations.pinLocked.body"
msgstr ""
"PINarekin saiakera huts gehiegi egin ondoren blokeatu da. Desblokeatu ezazu "
"bere PUKarekin, berriro sinatu aurretik."

msgid "errors.situations.tokenAbsent.title"
msgstr "Ez dugu txartela aurkitzen"

msgid "errors.situations.tokenAbsent.body"
msgstr ""
"Egiaztatu sartuta jarraitzen duela eta irakurgailua konektatuta dagoela, eta "
"saiatu berriro."

msgid "errors.situations.expiredSession.title"
msgstr "Txartelarekiko saioa iraungi da"

msgid "errors.situations.expiredSession.body"
msgstr ""
"Saiatu berriro: saio berri bat irekiko da eta PINa berriro eskatuko dizugu."

msgid "errors.situations.moduleNotFound.title"
msgstr "Ezin izan dugu txartelaren modulua kargatu"

msgid "errors.situations.moduleNotFound.body"
msgstr ""
"Egiaztatu PKCS#11 modulua esan duzun lekuan dagoela, edo aukeratu beste bat."

msgid "errors.situations.certificateNotFound.title"
msgstr "Ziurtagiria jada ez dago txartelean"

msgid "errors.situations.certificateNotFound.body"
msgstr "Bilatu ziurtagiriak berriro eta aukeratu dauden horietako bat."

msgid "errors.situations.certificateExpired.title"
msgstr "Ziurtagiria iraungi da"

msgid "errors.situations.certificateExpired.body"
msgstr ""
"Iraungitako ziurtagiri batek ez du sinatzeko balio. Berritu ezazu "
"jaulkitzailearekin eta saiatu berriro."

msgid "errors.situations.certificateNotYetValid.title"
msgstr "Ziurtagiria oraindik ez dago indarrean"

msgid "errors.situations.certificateNotYetValid.body"
msgstr ""
"Oraindik ez da hasi bere baliozkotasun-aldia; beraz, ez du sinatzeko balio."

msgid "errors.situations.certificateRevoked.title"
msgstr "Ziurtagiria errebokatuta dago"

msgid "errors.situations.certificateRevoked.body"
msgstr ""
"Jaulkitzaileak errebokatu du; beraz, ez du sinatzeko balio. Berri bat behar "
"duzu."

msgid "errors.situations.pkcs12Unreadable.title"
msgstr "Ezin izan da ziurtagiria ireki"

msgid "errors.situations.pkcs12Unreadable.body"
msgstr "Egiaztatu fitxategiaren pasahitza."

#. Un solo renglon a proposito (ID-211): no lleva cuerpo debajo, y por eso no
#. hay msgid "errors.situations.keyNotRsa.body".
msgid "errors.situations.keyNotRsa.title"
msgstr "Ziurtagiri hori ez da rFirmarekin bateragarria"

msgid "errors.situations.mechanismNotOffered.title"
msgstr "Tokenak ez du sinadura-algoritmo hori onartzen"

msgid "errors.situations.mechanismNotOffered.body"
msgstr ""
"Probatu beste ziurtagiri batekin edo eskatu egoitzari SHA-256 RSArekin "
"erabil dezala."

msgid "errors.situations.certificateUnreadable.title"
msgstr "Ezin izan dugu ziurtagiria irakurri"

msgid "errors.situations.certificateUnreadable.body"
msgstr ""
"Txartelean dagoena ez da irakurtzen dakigun ziurtagiri bat. Probatu beste "
"batekin."

msgid "errors.situations.notAPdf.title"
msgstr "Fitxategi hori ez da PDF bat"

msgid "errors.situations.notAPdf.body"
msgstr ""
"rFirmak PDFak sinatzen ditu. Aukeratu PDF dokumentu bat eta saiatu berriro."

msgid "errors.situations.documentEncrypted.title"
msgstr "PDFa babestuta dago"

msgid "errors.situations.documentEncrypted.body"
msgstr ""
"Zifratuta dago edo baimenak murriztuta ditu; beraz, ezin da sinatu. Ireki "
"ezazu bere pasahitzarekin, gorde babesik gabe eta saiatu berriro."

msgid "errors.situations.documentCertified.title"
msgstr "PDFa ziurtatuta dago"

msgid "errors.situations.documentCertified.body"
msgstr ""
"Egileak aldaketak debekatuz sinatu zuen; beraz, sinadura bat gehitzeak berea "
"baliogabetuko luke. Eskatu iezaiozu ziurtatu gabeko kopia bat."

msgid "errors.situations.documentUnreadable.title"
msgstr "Ezin izan dugu dokumentua irakurri"

msgid "errors.situations.documentUnreadable.body"
msgstr "Egiaztatu zegoen lekuan jarraitzen duela eta ireki berriro."

msgid "errors.situations.droppedFileUnreadable.title"
msgstr "Ezin izan dugu askatu duzun fitxategia irakurri"

msgid "errors.situations.droppedFileUnreadable.body"
msgstr ""
"Arrastatzeak ez digu edozein karpetatatik irakurtzeko baimenik ematen. Ireki "
"ezazu irekitzeko botoiarekin; horrek bai ematen digu."

msgid "errors.situations.droppedSomeDiscarded.title"
msgstr "Fitxategi batzuk ez dira gehitu"

msgid "errors.situations.droppedSomeDiscarded.body"
msgstr ""
"Askatu dituzun gainerako PDFak Azkenak zerrendan daude jada. PDF ez zirenak "
"ez dira gehitu."

msgid "errors.situations.boxOutOfPage.title"
msgstr "Laukia orrialdetik kanpo geratzen da"

msgid "errors.situations.boxOutOfPage.body"
msgstr ""
"Arrastatu orrialdearen barrura eta sinatu berriro. Horrela utziko bagenu, "
"PDFan moztuta geratuko litzateke abisatu gabe."

msgid "errors.situations.pageOutOfDocument.title"
msgstr "Dokumentuak ez du orrialde horretaraino iristen"

msgid "errors.situations.pageOutOfDocument.body"
msgstr ""
"Aukeratu dokumentuan dagoen orrialde bat eta sinatu berriro. Horrela utziko "
"bagenu, zigilua azken orrialdean amaituko luke abisatu gabe."

msgid "errors.situations.sealMismatch.title"
msgstr "Sinadura erdibidean eten da"

msgid "errors.situations.sealMismatch.body"
msgstr ""
"Hasieran prestatu genuena eta amaitzean jaso duguna ez datoz bat; beraz, "
"ezer idatzi aurretik gelditu gara. Sinatu dokumentua berriro."

msgid "errors.situations.bridgeFailed.title"
msgstr "Ezin izan dugu sinadura prestatu"

msgid "errors.situations.bridgeFailed.body"
msgstr ""
"Sinatutako PDFa osatzen duen osagaiak huts egin du. Saiatu berriro eta, "
"gertatzen jarraitzen badu, erantsi xehetasun teknikoa akatsaren txostenari."

msgid "errors.situations.folderMissing.title"
msgstr "Helburuko karpeta jada ez dago"

msgid "errors.situations.folderMissing.body"
msgstr ""
"Ez dugu zuretzat sortzen: sortuko bagenu, dokumentuak gordeta dagoela emango "
"luke eta ez legoke. Sortu berriro edo aukeratu beste bat Hobespenetan."

msgid "errors.situations.notAFolder.title"
msgstr "Helburua ez da karpeta bat"

msgid "errors.situations.notAFolder.body"
msgstr ""
"Karpeta bat espero genuen lekuan izen hori duen fitxategi bat dago. Aukeratu "
"beste helburu bat Hobespenetan."

msgid "errors.situations.folderUnreadable.title"
msgstr "Ezin izan dugu helburuko karpeta kontsultatu"

msgid "errors.situations.folderUnreadable.body"
msgstr ""
"Baimenen kontua izan daiteke, edo erantzuten ez duen unitate batena. "
"Aukeratu beste helburu bat Hobespenetan."

msgid "errors.situations.folderUnwritable.title"
msgstr "Ezin izan dugu sinatutako dokumentua gorde"

msgid "errors.situations.folderUnwritable.body"
msgstr ""
"Sinadura ondo atera da, baina fitxategia ezin izan da helburuko karpetan "
"idatzi. Aukeratu beste bat Hobespenetan eta sinatu berriro."

msgid "errors.situations.noFreeName.title"
msgstr "Izen hori duten dokumentu gehiegi daude jada"

msgid "errors.situations.noFreeName.body"
msgstr ""
"Bat ere ez zapaltzeko, gelditu egin gara. Mugitu edo berrizendatu aurrekoak "
"eta sinatu berriro."

msgid "errors.situations.settingNotSaved.title"
msgstr "Ezin izan dugu ezarpena gorde"

msgid "errors.situations.settingNotSaved.body"
msgstr ""
"Aurreko baliora itzuli gara; hori da gordeta jarraitzen duena. Saiatu "
"berriro eta, gertatzen jarraitzen badu, erantsi xehetasun teknikoa akatsaren "
"txostenari."

msgid "errors.situations.activityNotForgotten.title"
msgstr "Ezin izan dugu zerrenda hustu"

msgid "errors.situations.activityNotForgotten.body"
msgstr ""
"Azken dokumentuek eta ziurtagiriak gordeta jarraitzen dute. Saiatu berriro "
"eta, gertatzen jarraitzen badu, erantsi xehetasun teknikoa akatsaren "
"txostenari."

