<sc-if value="{{ esLinux }}" hint-placeholder-val="{{ true }}">
<div style="flex:none;background:var(--rf-bg);position:relative;z-index:{{ zCabecera }}">
<div style="background:color-mix(in srgb, var(--rf-text) 8%, var(--rf-bg));{{ estiloBordeHeaderbar }}">
  <div class="rf-row" style="height:47px;padding:0 8px 0 7px;gap:6px;position:relative">
    <sc-if value="{{ hayTira }}" hint-placeholder-val="{{ true }}">
      <div class="rf-row" style="height:34px;gap:0;position:relative">
        <span title="Ctrl+O" style="height:100%;display:flex;align-items:center;padding:0 12px;font-size:14px;font-weight:700;background:color-mix(in srgb, var(--rf-text) 8%, transparent);cursor:pointer;{{ estiloAbrirGtk }}">Abrir PDF…</span>
        <sc-if value="{{ hayRecientes }}" hint-placeholder-val="{{ true }}">
        <span style="width:1px;height:100%;background:color-mix(in srgb, var(--rf-text) 14%, transparent)"></span>
        <span role="button" title="Abiertos recientemente" aria-label="Abiertos recientemente" style="position:relative;width:30px;height:100%;display:flex;align-items:center;justify-content:center;border-radius:0 var(--rf-radius-md) var(--rf-radius-md) 0;{{ estiloFlechaGtk }}"><svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M4 6l4 4 4-4"/></svg>
          <sc-if value="{{ recientesGtkAbiertos }}" hint-placeholder-val="{{ false }}"><span style="position:absolute;top:calc(100% + 4px);left:9px;width:12px;height:12px;transform:rotate(45deg);background:var(--rf-bg);border-left:1px solid var(--rf-border-subtle);border-top:1px solid var(--rf-border-subtle);z-index:31"></span></sc-if>
        </span>
        </sc-if>
        <sc-if value="{{ recientesGtkAbiertos }}" hint-placeholder-val="{{ false }}">
          <div role="menu" style="position:absolute;top:calc(100% + 10px);left:0;width:380px;z-index:30;padding:6px;display:flex;flex-direction:column;gap:0;background:var(--rf-bg);border:1px solid var(--rf-border-subtle);border-radius:12px;box-shadow:var(--rf-shadow-elevated)">
            <span style="padding:6px 12px 4px;font-size:13px;font-weight:700;color:var(--rf-text-muted)">Abiertos recientemente</span>
            <sc-for list="{{ recientesGtk }}" as="r" hint-placeholder-count="6">
              <div class="rf-row" role="menuitem" aria-disabled="{{ r.desactivada }}" style="gap:8px;min-height:32px;padding:0 12px;border-radius:var(--rf-radius-md);font-size:14px;color:var(--rf-text);cursor:pointer;{{ r.estilo }}" title="{{ r.titulo }}">
                <span style="width:14px;flex:none;display:flex">
                  <sc-if value="{{ r.firmado }}" hint-placeholder-val="{{ false }}"><svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 8.5l3 3 7-7"/></svg></sc-if>
                </span>
                <span style="flex:1;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">{{ r.texto }}</span>
              </div>
            </sc-for>
            <hr class="rf-divider" style="margin:6px 0">
            <div class="rf-row" role="menuitem" style="min-height:32px;padding:0 12px;border-radius:var(--rf-radius-md);font-size:14px;color:var(--rf-text);cursor:pointer">Vaciar la lista</div>
          </div>
        </sc-if>
      </div>
    </sc-if>
    <span style="position:absolute;left:50%;top:0;height:47px;display:flex;align-items:center;transform:translateX(-50%);font-size:14px;font-weight:700;pointer-events:none">rFirma</span>
    <span style="flex:1"></span>
    <sc-if value="{{ hayBotonAviso }}" hint-placeholder-val="{{ true }}">
      <span role="button" title="Estado de rFirma: requiere atención" aria-label="Estado de rFirma: requiere atención" style="width:34px;height:34px;flex:none;display:flex;align-items:center;justify-content:center;border-radius:var(--rf-radius-md);color:var(--rf-text);cursor:pointer"><svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true"><path d="M8 1.6c.4 0 .75.2.95.55l5.8 10.3c.4.73-.12 1.55-.95 1.55H2.2c-.83 0-1.35-.82-.95-1.55l5.8-10.3c.2-.35.55-.55.95-.55z" fill="currentColor"/><path d="M8 5.6v3.6M8 11.4v.2" stroke="color-mix(in srgb, var(--rf-text) 8%, var(--rf-bg))" stroke-width="1.7" stroke-linecap="round"/></svg></span>
    </sc-if>
    <div style="position:relative;display:flex">
      <span role="button" title="Menú principal" aria-label="Menú principal" style="width:34px;height:34px;display:flex;align-items:center;justify-content:center;border-radius:var(--rf-radius-md);color:var(--rf-text);cursor:pointer;{{ estiloBotonMenuGtk }}"><svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"><path d="M2.5 4h11M2.5 8h11M2.5 12h11"/></svg></span>
      <sc-if value="{{ menuGtkAbierto }}" hint-placeholder-val="{{ false }}">
        <div role="menu" style="position:absolute;top:calc(100% + 10px);right:-8px;min-width:220px;z-index:30;padding:6px;display:flex;flex-direction:column;gap:0;background:var(--rf-bg);border:1px solid var(--rf-border-subtle);border-radius:12px;box-shadow:var(--rf-shadow-elevated)">
          <span style="position:absolute;top:-7px;right:19px;width:12px;height:12px;transform:rotate(45deg);background:var(--rf-bg);border-left:1px solid var(--rf-border-subtle);border-top:1px solid var(--rf-border-subtle)"></span>
          <div class="rf-row" role="menuitem" style="min-height:32px;padding:0 12px;border-radius:var(--rf-radius-md);font-size:14px;color:var(--rf-text);cursor:pointer">Estado de rFirma</div>
          <hr class="rf-divider" style="margin:6px 0">
          <div class="rf-row" role="menuitem" style="min-height:32px;padding:0 12px;border-radius:var(--rf-radius-md);font-size:14px;color:var(--rf-text);cursor:pointer">Preferencias…</div>
          <div class="rf-row" role="menuitem" style="min-height:32px;padding:0 12px;border-radius:var(--rf-radius-md);font-size:14px;color:var(--rf-text);cursor:pointer">Comentarios y ayuda</div>
          <div class="rf-row" role="menuitem" style="min-height:32px;padding:0 12px;border-radius:var(--rf-radius-md);font-size:14px;color:var(--rf-text);cursor:pointer">Acerca de rFirma</div>
        </div>
      </sc-if>
    </div>
    <div class="rf-row" style="gap:12px;margin-left:10px">
      <span title="Minimizar" style="width:24px;height:24px;flex:none;display:flex;align-items:center;justify-content:center;border-radius:var(--rf-radius-pill);background:color-mix(in srgb, var(--rf-text) 10%, transparent);color:var(--rf-text)"><svg width="10" height="10" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4.5 11h7"/></svg></span>
      <span title="Maximizar" style="width:24px;height:24px;flex:none;display:flex;align-items:center;justify-content:center;border-radius:var(--rf-radius-pill);background:color-mix(in srgb, var(--rf-text) 10%, transparent);color:var(--rf-text)"><svg width="10" height="10" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="4" width="8" height="8" rx="1"/></svg></span>
      <span title="Cerrar" style="width:24px;height:24px;flex:none;display:flex;align-items:center;justify-content:center;border-radius:var(--rf-radius-pill);background:color-mix(in srgb, var(--rf-text) 10%, transparent);color:var(--rf-text)"><svg width="10" height="10" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4.5 4.5l7 7M11.5 4.5l-7 7"/></svg></span>
    </div>
  </div>
</div>
<sc-if value="{{ hayFilaPestanas }}" hint-placeholder-val="{{ true }}">
  <div class="rf-row" style="height:38px;padding:0 6px 0 4px;gap:0;align-items:stretch;position:relative;background:color-mix(in srgb, var(--rf-text) 8%, var(--rf-bg));border-bottom:1px solid var(--rf-border-subtle);z-index:{{ zCabecera }}">
    <div style="height:100%;flex:0 1 auto;min-width:0;overflow:hidden">
      <div class="rf-row" style="height:100%;align-items:stretch;gap:2px">
        <sc-for list="{{ pestanas }}" as="p" hint-placeholder-count="3">
          <div class="rf-row" title="{{ p.nombre }}" style="{{ p.estilo }}">
            <span style="display:flex;flex:none"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z"/><path d="M14 3v5h5"/></svg></span>
            <span style="flex:1;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">{{ p.nombre }}</span>
            <sc-if value="{{ p.firmado }}" hint-placeholder-val="{{ false }}">
              <span title="Firmado" style="display:flex;flex:none;color:var(--rf-text-muted)"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12.5l4.5 4.5L19 7.5"/></svg></span>
            </sc-if>
            <span title="Cerrar" style="{{ p.estiloCerrar }}"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M6 6l12 12M18 6 6 18"/></svg></span>
          </div>
        </sc-for>
      </div>
    </div>

    <sc-if value="{{ desborda }}" hint-placeholder-val="{{ false }}">
      <div style="flex:none;display:flex;align-items:center;margin-left:4px;position:relative">
        <button type="button" class="rf-btn rf-btn--ghost" title="Más pestañas" style="{{ estiloDesborde }}">+{{ nOcultas }}<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="{{ estiloGiroDesborde }}"><path d="M6 9l6 6 6-6"/></svg></button>
        <sc-if value="{{ desbordeAbierto }}" hint-placeholder-val="{{ false }}">
          <div class="rf-stack" style="position:absolute;top:100%;right:0;margin-top:4px;width:360px;padding:6px;gap:2px;
            border-radius:var(--rf-radius-lg);border:1px solid var(--rf-border-subtle);background:var(--rf-bg);box-shadow:var(--rf-shadow-elevated)">
            <sc-for list="{{ ocultas }}" as="o" hint-placeholder-count="8">
              <div class="rf-row" style="gap:6px;min-width:0;padding:7px 10px;border-radius:var(--rf-radius-md);cursor:pointer" title="{{ o.nombre }}">
                <span style="min-width:0;font-size:13px;line-height:1.3;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">{{ o.nombre }}</span>
                <sc-if value="{{ o.firmado }}" hint-placeholder-val="{{ false }}">
                  <span title="Firmado" style="display:flex;flex:none;color:var(--rf-text-muted)"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12.5l4.5 4.5L19 7.5"/></svg></span>
                </sc-if>
              </div>
            </sc-for>
          </div>
        </sc-if>
      </div>
    </sc-if>
  </div>
</sc-if>
</div>
</sc-if>
<sc-if value="{{ noLinux }}" hint-placeholder-val="{{ false }}">
<header class="rf-row" style="height:44px;flex:none;align-items:stretch;gap:0;padding:0 6px 0 4px;
  background:var(--rf-bg);border-bottom:1px solid var(--rf-border-subtle);position:relative;z-index:{{ zCabecera }}">
  <span style="flex:none;display:flex;align-items:center;padding:0 12px 0 8px;font-size:15px;font-weight:700;letter-spacing:.4px">rFirma</span>

  <sc-if value="{{ hayTira }}" hint-placeholder-val="{{ true }}">
    <div style="flex:none;display:flex;align-items:center;margin-right:12px;position:relative">
      <div class="rf-row" style="height:32px;border:1px solid var(--rf-border-strong);border-radius:var(--rf-radius-md);background:var(--rf-bg)">
        <button type="button" class="rf-btn rf-btn--ghost" title="Ctrl+O" style="{{ estiloAbrir }}">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M3 7a2 2 0 0 1 2-2h4l2 2h8a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/></svg>Abrir PDF…</button>
        <sc-if value="{{ hayRecientes }}" hint-placeholder-val="{{ true }}">
          <span style="width:1px;height:16px;background:var(--rf-border-subtle)"></span>
          <button type="button" title="Abiertos recientemente" class="rf-btn rf-btn--ghost" style="{{ estiloFlecha }}"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="{{ estiloGiro }}"><path d="M6 9l6 6 6-6"/></svg></button>
        </sc-if>
      </div>
      <sc-if value="{{ recientesAbiertos }}" hint-placeholder-val="{{ false }}">
        <div class="rf-stack" style="position:absolute;top:100%;left:0;margin-top:4px;width:360px;padding:6px;gap:2px;
          border-radius:var(--rf-radius-lg);border:1px solid var(--rf-border-subtle);background:var(--rf-bg);box-shadow:var(--rf-shadow-elevated)">
          <span class="rf-label" style="padding:6px 10px 4px;letter-spacing:.6px;text-transform:uppercase">Abiertos recientemente</span>
          <sc-for list="{{ recientes }}" as="r" hint-placeholder-count="6">
            <div class="rf-row" style="gap:10px;padding:7px 10px;border-radius:var(--rf-radius-md);{{ r.estilo }}" title="{{ r.titulo }}">
              <div class="rf-stack" style="flex:1;min-width:0;gap:3px">
                <span class="rf-row" style="gap:6px;min-width:0">
                  <span style="min-width:0;font-size:13px;line-height:1.3;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">{{ r.nombre }}</span>
                  <sc-if value="{{ r.firmado }}" hint-placeholder-val="{{ false }}">
                    <span title="Firmado" style="display:flex;flex:none;color:var(--rf-text-muted)"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12.5l4.5 4.5L19 7.5"/></svg></span>
                  </sc-if>
                </span>
                <span class="rf-text-muted" style="font-size:12px;line-height:1.3;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">{{ r.carpeta }}</span>
              </div>
              <span class="rf-text-muted" style="flex:none;font-size:12px;{{ r.estiloCuando }}">{{ r.cuando }}</span>
            </div>
          </sc-for>
          <hr class="rf-divider" style="margin:4px 0">
          <div class="rf-row" style="min-height:32px;padding:0 10px;border-radius:var(--rf-radius-md);font-size:13px;color:var(--rf-text-muted);cursor:pointer">Vaciar la lista</div>
        </div>
      </sc-if>
    </div>

    <div style="height:100%;flex:0 1 auto;min-width:0;overflow:hidden">
      <div class="rf-row" style="height:100%;align-items:stretch;gap:2px">
        <sc-for list="{{ pestanas }}" as="p" hint-placeholder-count="3">
          <div class="rf-row" title="{{ p.nombre }}" style="{{ p.estilo }}">
            <span style="display:flex;flex:none"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z"/><path d="M14 3v5h5"/></svg></span>
            <span style="flex:1;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">{{ p.nombre }}</span>
            <sc-if value="{{ p.firmado }}" hint-placeholder-val="{{ false }}">
              <span title="Firmado" style="display:flex;flex:none;color:var(--rf-text-muted)"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12.5l4.5 4.5L19 7.5"/></svg></span>
            </sc-if>
            <span title="Cerrar" style="{{ p.estiloCerrar }}"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M6 6l12 12M18 6 6 18"/></svg></span>
          </div>
        </sc-for>
      </div>
    </div>

    <sc-if value="{{ desborda }}" hint-placeholder-val="{{ false }}">
      <div style="flex:none;display:flex;align-items:center;margin-left:4px;position:relative">
        <button type="button" class="rf-btn rf-btn--ghost" title="Más pestañas" style="{{ estiloDesborde }}">+{{ nOcultas }}<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="{{ estiloGiroDesborde }}"><path d="M6 9l6 6 6-6"/></svg></button>
        <sc-if value="{{ desbordeAbierto }}" hint-placeholder-val="{{ false }}">
          <div class="rf-stack" style="position:absolute;top:100%;right:0;margin-top:4px;width:360px;padding:6px;gap:2px;
            border-radius:var(--rf-radius-lg);border:1px solid var(--rf-border-subtle);background:var(--rf-bg);box-shadow:var(--rf-shadow-elevated)">
            <sc-for list="{{ ocultas }}" as="o" hint-placeholder-count="8">
              <div class="rf-row" style="gap:6px;min-width:0;padding:7px 10px;border-radius:var(--rf-radius-md);cursor:pointer" title="{{ o.nombre }}">
                <span style="min-width:0;font-size:13px;line-height:1.3;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">{{ o.nombre }}</span>
                <sc-if value="{{ o.firmado }}" hint-placeholder-val="{{ false }}">
                  <span title="Firmado" style="display:flex;flex:none;color:var(--rf-text-muted)"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12.5l4.5 4.5L19 7.5"/></svg></span>
                </sc-if>
              </div>
            </sc-for>
          </div>
        </sc-if>
      </div>
    </sc-if>
  </sc-if>
  <span style="flex:1;min-width:24px"></span>
  <sc-if value="{{ hayBotonAviso }}" hint-placeholder-val="{{ true }}">
    <div style="flex:none;display:flex;align-items:center;margin-right:2px">
      <span role="button" title="Estado de rFirma: requiere atención" aria-label="Estado de rFirma: requiere atención" style="width:32px;height:30px;display:flex;align-items:center;justify-content:center;
        border-radius:var(--rf-radius-md);color:var(--rf-text);cursor:pointer">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 4 2.5 20h19z"/><path d="M12 10v4M12 17v.5"/></svg></span>
    </div>
  </sc-if>
  <sc-if value="{{ hayHamburguesa }}" hint-placeholder-val="{{ true }}">
  <div style="flex:none;display:flex;align-items:center;margin-right:4px">
    <span title="Menú" style="width:32px;height:30px;display:flex;align-items:center;justify-content:center;
      border-radius:var(--rf-radius-md);{{ estiloBotonMenu }}">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M4 7h16M4 12h16M4 17h16"/></svg></span>
  </div>
  </sc-if>
  <sc-if value="{{ menuWinAbierto }}" hint-placeholder-val="{{ false }}">
    <div role="menu" style="position:absolute;top:48px;right:10px;min-width:230px;padding:6px;
      background:var(--rf-bg);border:1px solid var(--rf-border-subtle);border-radius:var(--rf-radius-md);
      box-shadow:var(--rf-shadow-elevated);display:flex;flex-direction:column;gap:2px">
      <sc-for list="{{ entradasMenu }}" as="e" hint-placeholder-count="4">
        <sc-if value="{{ e.hayDivisor }}" hint-placeholder-val="{{ false }}">
          <hr class="rf-divider" style="margin:4px 0">
        </sc-if>
        <span class="rf-prose rf-row rf-gap-xs" role="menuitem" style="padding:9px 10px;border-radius:var(--rf-radius-sm);cursor:pointer;{{ e.estiloFoco }}">
          <span style="flex:1;min-width:0">{{ e.texto }}</span>
          <span style="width:14px;height:14px;flex:none;display:flex;align-items:center;justify-content:center">
            <sc-if value="{{ e.esEnlace }}" hint-placeholder-val="{{ false }}">
              <span style="display:flex;color:var(--rf-text-muted)"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M14 4h6v6"/><path d="M20 4 11 13"/><path d="M18 14v4a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4"/></svg></span>
            </sc-if>
          </span>
        </span>
      </sc-for>
    </div>
  </sc-if>
</header>
</sc-if>
