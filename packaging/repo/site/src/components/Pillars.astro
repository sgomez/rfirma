---
import { translator, type Locale } from "../i18n";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = translator(locale);
---

<section id="caracteristicas" style="position:relative;background:#ffffff">
  <div style="max-width:76rem;margin:0 auto;padding:clamp(56px,8vw,112px) clamp(16px,4vw,32px)">
    <div data-reveal style="max-width:40rem;margin:0 auto;text-align:center">
      <span
        style="display:block;margin-bottom:12px;font-size:.8125rem;font-weight:700;letter-spacing:.14em;text-transform:uppercase;color:var(--rf-brand-text)"
        >{t("pillars.kicker")}</span
      >
      <h2
        style="margin:0;font-size:clamp(1.85rem,3.8vw,2.6rem);font-weight:800;line-height:1.15;letter-spacing:-.03em"
      >
        {t("pillars.title")}
      </h2>
      <p style="margin:12px 0 0;font-size:1.0625rem;color:var(--rf-text-muted);text-wrap:pretty">
        {t("pillars.body")}
      </p>
    </div>
    <div
      style="display:grid;grid-template-columns:repeat(auto-fit,minmax(min(240px,100%),1fr));gap:clamp(16px,2.5vw,28px);margin-top:clamp(32px,5vw,64px)"
    >
      <div data-pillar data-reveal="1">
        <span data-pillar-icon
          ><svg
            width="30"
            height="30"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.6"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
            ><rect x="7" y="7" width="10" height="10" rx="2"></rect><path
              d="M12 3v4M12 17v4M3 12h4M17 12h4M5.5 5.5l2 2M16.5 16.5l2 2M18.5 5.5l-2 2M7.5 16.5l-2 2"
            ></path></svg
          ></span
        >
        <h3 style="margin:0;font-size:1.125rem;font-weight:700;line-height:1.3">{t("pillars.native.title")}</h3>
        <p style="margin:0;font-size:.9375rem;line-height:1.65;color:var(--rf-text-muted)">
          {t("pillars.native.body")}
        </p>
      </div>
      <div data-pillar="lead" data-reveal="2">
        <span data-pillar-icon="dark"
          ><svg
            width="30"
            height="30"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.6"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
            ><rect x="4" y="10" width="16" height="10" rx="2"></rect><path d="M8 10V7a4 4 0 0 1 8 0v3"
            ></path></svg
          ></span
        >
        <h3 style="margin:0;font-size:1.125rem;font-weight:700;line-height:1.3">{t("pillars.keys.title")}</h3>
        <p style="margin:0;font-size:.9375rem;line-height:1.65;color:var(--rf-text-muted)">
          {t("pillars.keys.body")}
        </p>
      </div>
      <div data-pillar data-reveal="3">
        <span data-pillar-icon
          ><svg
            width="30"
            height="30"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.6"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"><path d="M4 20h16M6 20V10M18 20V10M10 20V10M14 20V10M3 10h18L12 4z"></path></svg
          ></span
        >
        <h3 style="margin:0;font-size:1.125rem;font-weight:700;line-height:1.3">{t("pillars.crypto.title")}</h3>
        <p
          style="margin:0;font-size:.9375rem;line-height:1.65;color:var(--rf-text-muted)"
          set:html={t("pillars.crypto.body")}
        />
      </div>
      <div data-pillar data-reveal="4">
        <span data-pillar-icon="amber"
          ><svg
            width="30"
            height="30"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.6"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
            ><path d="M4 19c3-8 6-10 7-6.5S9 20 8 18s3-6.5 7-7.5 2 3.5 4 3.5 3.5-2.5 4.5-4.5"></path></svg
          ></span
        >
        <h3 style="margin:0;font-size:1.125rem;font-weight:700;line-height:1.3">{t("pillars.stamp.title")}</h3>
        <p style="margin:0;font-size:.9375rem;line-height:1.65;color:var(--rf-text-muted)">
          {t("pillars.stamp.body")}
        </p>
      </div>
    </div>
  </div>
</section>
