msgstr "Ulertuta"

msgid "sede.refusals.appendedSignaturePage"
msgstr ""
"{{origin}}(e)k sinadura amaieran gehitutako orrialde batean jartzeko "
"eskatzen du, eta rFirmak ez du hori egiten."

msgid "sede.refusals.unsupportedFilter"
msgstr ""
"{{origin}}(e)k ziurtagiriak rFirmak ezagutzen ez duen irizpide batekin "
"iragazteko eskatzen du."

msgid "sede.refusals.unsupportedProtocolVersion"
msgstr ""
"{{origin}}(e)k rFirmak ulertzen ez duen protokolo-bertsio bat hitz egiten du."

msgid "sede.refusals.missingFormat"
msgstr "{{origin}}(e)k ez du esaten zein formatutan sinatu behar den."

msgid "sede.refusals.unsupportedKeyStore"
msgstr ""
"{{origin}}(e)k rFirmak ireki ezin duen ziurtagiri-biltegi batekin sinatzeko "
"eskatzen du."

msgid "sede.refusals.errandInFlight"
msgstr ""
"{{origin}}(e)k sinadura bat eskatzen du beste izapide bat irekita dagoela, "
"eta rFirmak banaka artatzen ditu."

msgid "sede.refusals.portsTaken"
msgstr ""
"{{origin}}(e)k eskaintzen dituen atakak beste aplikazio bat erabiltzen ari "
"da, eta rFirmak ezin izan du erantzuteko kanala ireki. Itxi aplikazio hori "
"(AutoFirma edo rFirmaren beste kopia bat izan daiteke) eta saiatu berriro "
"orritik."

msgid "sede.refusals.unknown"
msgstr "{{origin}}(e)k rFirmak artatu ezin duen zerbait bidali du."

msgid "sede.refusals.saveCancelled"
msgstr ""
"Gordetzeko elkarrizketa-koadroa itxi duzu, {{origin}}(e)k eskatzen zuen "
"fitxategia non gorde aukeratu gabe."

msgid "sede.refusals.loadCancelled"
msgstr ""
"Kargatzeko elkarrizketa-koadroa itxi duzu, {{origin}}(e)rentzat fitxategirik "
"aukeratu gabe."

msgid "sede.refusals.cannotSaveData"
msgstr ""
"{{origin}}(e)k eskatzen zuen fitxategia ezin izan da aukeratu duzun lekuan "
"idatzi."

msgid "sede.refusals.cannotLoadData"
msgstr ""
"{{origin}}(e)rentzat aukeratutako fitxategietako bat ezin izan da irakurri."

msgid "sede.refusals.batchPresignerUnreachable"
msgstr "Sorta prestatzen duen {{origin}}(e)ko zerbitzuak ez du erantzun."

msgid "sede.refusals.batchPostsignerUnreachable"
msgstr "Sorta ixten duen {{origin}}(e)ko zerbitzuak ez du erantzun."

msgid "sede.refusals.batchInvalidPresignResponse"
msgstr ""
"Sorta prestatzen duen {{origin}}(e)ko zerbitzuak rFirmak irakurtzen ez "
"dakien zerbait erantzun du."

msgid "sede.refusals.batchInvalidPostsignResponse"
msgstr ""
"Sorta ixten duen {{origin}}(e)ko zerbitzuak rFirmak irakurtzen ez dakien "
"zerbait erantzun du."

msgid "sede.refusals.batchSigningFailed"
msgstr "{{origin}}(e)k eskatzen zuen sortaren sinadura ez da osatzera iritsi."

msgid "sede.refusals.triphaseServerUrlMissing"
msgstr ""
"{{origin}}(e)k bere sinadura-zerbitzuarekin sinatzeko eskatu du, baina ez du "
"esan non dagoen."

msgid "sede.refusals.triphaseServerException"
msgstr "{{origin}}(e)ko sinadura-zerbitzuak errore bat eman du."

msgid "sede.refusals.triphaseServerUnreachable"
msgstr "{{origin}}(e)ko sinadura-zerbitzuak ez du erantzun."

msgid "sede.refusals.triphaseServerUnexpectedAnswer"
msgstr ""
"{{origin}}(e)ko sinadura-zerbitzuak rFirmak irakurtzen ez dakien zerbait "
"erantzun du."

msgid "sede.refusals.certificateNotFound"
msgstr ""
"Aukeratutako ziurtagiria jada ez dago erabilgarri, edo {{origin}}(e)k ez du "
"onartzen."

msgid "sede.refusals.folderMissing"
msgstr ""
"rFirmak {{origin}}(e)rako idatzi behar zuen karpeta jada ez da existitzen."

msgid "sede.refusals.unwritable"
msgstr "rFirmak ezin izan du idatzi {{origin}}(e)k behar zuen fitxategia."

msgid "sede.refusals.invalidSignature"
msgstr ""
"{{origin}}(e)k bidali duen dokumentuak baliozkoa ez den sinadura bat dakar."

msgid "sede.refusals.confirmationNeeded"
msgstr ""
"{{origin}}(e)k zuri galdetu gabe sinatzeko eskatu du, baina dokumentuak "
"zerbait berrestea behar du lehenago."

msgid "sede.refusals.localBatchSign"
msgstr "{{origin}}(e)k bidali duen sorta ezin da dagoen bezala sinatu."

msgid "sede.refusals.siteErrandNotLive"
msgstr ""
"{{origin}}(e)rekin zegoen izapidea amaituta zegoen zure erantzuna iritsi "
"zenean."

msgid "sede.refusals.pdfHasUnregisteredSignatures"
msgstr ""
"{{origin}}(e)k bidali duen PDFak bere inprimakian jasota ez dauden sinadurak "
"dakartza, eta rFirmak ez du horien gainean sinatzen zuk berretsi gabe."

msgid "sede.refusals.secretOnTheReaderKeypad"
msgstr ""
"Ziurtagiri honen PINa irakurgailuan idazten da, eta rFirmak oraindik ez daki "
"horrela eskatzen."

msgid "sede.refusals.userCancelled"
msgstr ""
"PIN eskaera bertan behera utzi duzu; beraz, {{origin}}(e)k eskatzen zuen "
"sinadura ez da egin."

msgid "sede.refusals.promptFailed"
msgstr ""
"rFirmak ezin izan dizu PINa eskatu {{origin}}(e)k eskatzen zuen sinadurarako."

msgid "sede.refusals.explicitXades"
msgstr ""
"{{origin}}(e)k sinadura mota zahar bat eskatu du, jada segurua ez dena: "
"sinadura hori zurea ez den beste dokumentu batena balitz bezala pasa liteke. "
"Horregatik, rFirmak ez du egiten. Ez da zure akatsa; izapidea amaitu behar "
"baduzu, jarri harremanetan {{origin}}(e)rekin."

msgid "sede.refusals.invoiceMultisignature"
msgstr ""
"{{origin}}(e)k dagoeneko sinatuta dagoen faktura elektroniko bati sinadura "
"bat gehitzeko eskatu du. Faktura elektronikoak sinadura bakarra onartzen du, "
"beraz rFirmak ezin du egin. Ez da zure akatsa; izapidea amaitu behar baduzu, "
"jarri harremanetan {{origin}}(e)rekin."

msgid "sede.refusals.unsupportedCountersignature"
msgstr ""
"{{origin}}(e)k beste pertsona baten sinaduraren gainean sinatzeko eskatu du, "
"hori onartzen ez duen dokumentu mota batean, beraz rFirmak ezin du egin. Ez "
"da zure akatsa; izapidea amaitu behar baduzu, jarri harremanetan {{origin}}"
"(e)rekin."

msgid "sede.siteNotes.explicitXades"
msgstr ""
"Kendu mode=explicit edo erabili CAdES esplizitua, dokumentua sartu gabe "
"sinatzen baitu."

msgid "sede.siteNotes.invoiceMultisignature"
msgstr ""
"FacturaE-k ez du kosinadurarik ez kontrasinadurarik onartzen; eskatu "
"sinadura soil bat (sign)."

msgid "sede.siteNotes.unsupportedCountersignature"
msgstr ""
"Kontrasinadura CAdES, CMS eta XAdES formatuetan bakarrik dago; beste formatu "
"batean, eskatu kosinadura bat (cosign)."

msgid "sede.noCertificate.noneTitle"
msgstr "Ez duzu ziurtagiririk"

