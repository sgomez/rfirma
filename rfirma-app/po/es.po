msgstr "Firmar documento"

msgid "actions.cancel"
msgstr "Cancelar"

msgid "actions.close"
msgstr "Cerrar"

msgid "actions.change"
msgstr "Cambiar"

#. Endónimo: el nombre del idioma en sí mismo, no se traduce.
msgid "languages.es"
msgstr "Español"

