{
  "$schema": "https://schema.tauri.app/config/2",
  "bundle": {
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.png", "icons/icon.ico"],
    "resources": {
      "../../rfirma-native-bridge/target/lib/rfirma/rfirma_crypto.dll": "rfirma_crypto.dll",
      "target/windows-runtime/vcruntime140.dll": "vcruntime140.dll",
      "target/windows-runtime/vcruntime140_1.dll": "vcruntime140_1.dll"
    },
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper", "silent": true },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Spanish", "English"],
        "displayLanguageSelector": false,
        "installerHooks": "../../packaging/windows/hooks.nsh"
      }
    }
  }
}
