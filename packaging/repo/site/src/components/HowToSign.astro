---
import { Image } from "astro:assets";
import step1 from "../assets/how-step1.png";
import step2 from "../assets/how-step2.png";
import step3 from "../assets/how-step3.png";
import step4 from "../assets/how-step4.png";
import { translator, type Locale } from "../i18n";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = translator(locale);
const steps = [
  { title: "how.step1.title", body: "how.step1.body", alt: "how.step1.alt" },
  { title: "how.step2.title", body: "how.step2.body", alt: "how.step2.alt" },
  { title: "how.step3.title", body: "how.step3.body", alt: "how.step3.alt" },
  { title: "how.step4.title", body: "how.step4.body", alt: "how.step4.alt" },
] as const;
const screenshots = [step1, step2, step3, step4];
---

<section id="firmar" class="demo" data-step="0" style="position:relative;background:#ffffff;overflow:clip">
  <div data-band aria-hidden="true"></div>
  <div
    style="position:relative;z-index:1;max-width:76rem;margin:0 auto;padding:clamp(56px,8vw,112px) clamp(16px,4vw,32px)"
  >
    <div data-reveal style="max-width:40rem;margin:0 auto clamp(24px,4vw,48px);text-align:center">
      <span
        style="display:block;margin-bottom:12px;font-size:.8125rem;font-weight:700;letter-spacing:.14em;text-transform:uppercase;color:var(--rf-brand-text)"
        >{t("how.kicker")}</span
      >
      <h2
        style="margin:0;font-size:clamp(1.85rem,3.8vw,2.6rem);font-weight:800;line-height:1.15;letter-spacing:-.03em"
      >
        {t("how.title")}
      </h2>
    </div>
    <div
      data-demo-grid
      style="display:grid;grid-template-columns:minmax(0,.85fr) minmax(0,1.15fr);gap:clamp(24px,4vw,56px);align-items:start"
    >
      <div style="min-width:0">
        {
          steps.map((step, index) => (
            <div class="demo-step" data-index={String(index)}>
              <span class="demo-step__number">{`0${index + 1}`}</span>
              <h3 class="demo-step__title">{t(step.title)}</h3>
              <p class="demo-step__body">{t(step.body)}</p>
            </div>
          ))
        }
      </div>

      <div data-demo-mock style="position:sticky;top:88px;min-width:0">
        {
          screenshots.map((screenshot, index) => (
            <Image
              src={screenshot}
              alt={t(steps[index].alt)}
              data-steps={String(index)}
              hidden={index !== 0}
              loading={index === 0 ? "eager" : "lazy"}
              format="webp"
              widths={[640, 960, 1280]}
              sizes="(min-width: 960px) 600px, 100vw"
              style="width:100%;height:auto;vertical-align:top"
            />
          ))
        }

        <div
          role="tablist"
          aria-label={t("how.tablist.aria")}
          style="display:flex;flex-wrap:wrap;gap:8px;justify-content:center;margin-top:22px"
        >
          {
            steps.map((_step, index) => (
              <button
                type="button"
                role="tab"
                class="demo-dot"
                data-demo-dot
                aria-selected={index === 0 ? "true" : "false"}
              >
                {index + 1}
              </button>
            ))
          }
        </div>
      </div>
    </div>
  </div>
</section>
