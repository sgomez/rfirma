#. La misma nota cuando no hay un origen válido que nombrar.
msgid "sede.received.narrowedUnknownOrigin"
msgstr "La seu només admet alguns certificats"

#. La sede pide una firma con SHA-1 que Preferencias no permite: el botón dice «Firmar igualmente».
msgid "sede.received.sha1ToAllow"
msgstr "Aquesta seu fa servir un mètode de signatura poc segur"

#. La sede firma con su servidor trifásico: el aviso de lo recibido lo dice.
msgid "sede.received.siteServer"
msgstr "El servidor de la seu prepara la signatura amb aquest document"

#. Encabezado del lote remoto: cuenta firmas, porque los documentos no se ven.
msgid "sede.received.signatures"
msgid_plural "sede.received.signatures"
msgstr[0] "Faràs 1 signatura"
msgstr[1] "Faràs {{count}} signatures"
msgstr[2] "Faràs {{count}} signatures"

#. Aviso de lo recibido en un lote remoto: los documentos los tiene el servidor de la sede.
msgid "sede.received.remoteBatch"
msgstr ""
"Els documents es queden al servidor de la seu, i rFirma no te'ls pot ensenyar"

#. Aviso informativo: la sede solo manda la huella del documento y rFirma no tiene qué enseñar.
msgid "sede.received.precalculatedHash"
msgstr ""
"La seu només envia l'empremta del document, així que rFirma no pot ensenyar-"
"te'l"

#. El botón de firmar cuando la sede pide SHA-1 sin permiso en Preferencias; lleva la cuenta atrás obligada.
msgid "sede.received.signAnyway"
msgstr "Signar igualment"

msgid "sede.received.download"
msgstr "Baixar"

msgid "sede.received.downloadAll"
msgstr "Baixar-ho tot"

#. La ayuda de «Descargar» con un solo documento: se guarda tal cual, sin .zip.
msgid "sede.received.downloadTitle"
msgstr "El document tal com és, sense canvis"

#. La ayuda de «Descargar todo»: un .zip con los documentos y un SHA256SUMS.
msgid "sede.received.downloadAllTitle"
msgid_plural "sede.received.downloadAllTitle"
msgstr[0] "El document i la seva empremta SHA-256, en un .zip"
msgstr[1] "Els {{count}} documents i les seves empremtes SHA-256, en un .zip"
msgstr[2] "Els {{count}} documents i les seves empremtes SHA-256, en un .zip"

#. {{name}} es el nombre del documento.
msgid "sede.received.actionsOf"
msgstr "Accions de {{name}}"

msgid "sede.received.openWith"
msgstr "Obrir amb…"

#. Texto oculto para lectores de pantalla junto al sello de un documento de la lista que ya trae firmas.
msgid "sede.received.withSignatures"
msgstr "Amb signatures"

#. Texto oculto para lectores de pantalla junto al sello de un documento de la lista que trae alguna firma caducada o no válida, o algún hallazgo.
msgid "sede.received.withTroubledSignatures"
msgstr "Amb signatures amb incidències"

msgid "sede.received.saveCopy"
msgstr "Desar una còpia"

msgid "sede.received.copySha256"
msgstr "Copiar SHA-256"

#. El visor de la vista ampliada, en vez del documento, cuando su tipo no tiene vista previa.
msgid "sede.received.noPreview"
msgstr "Aquest tipus de fitxer no es pot mostrar aquí."

#. Un solo documento que la persona ya firmó con el certificado elegido.
msgid "sede.received.signedByYouOne"
msgstr "Ho vas signar tu amb aquest certificat"

#. Un solo documento que la persona ya firmó con otro certificado suyo, del mismo titular y entidad.
msgid "sede.received.signedByYouOtherCertificateOne"
msgstr "Ho vas signar tu amb un altre certificat teu"

#. Un solo documento, que ya trae firmas de otras personas.
msgid "sede.received.signedOne"
msgstr "Porta signatures d'altres persones"

#. Cuántos documentos del lote ya traen firmas de otras personas, válidas o no.
msgid "sede.received.signedCount"
msgid_plural "sede.received.signedCount"
msgstr[0] "{{count}} porta signatures d'altres persones"
msgstr[1] "{{count}} porten signatures d'altres persones"
msgstr[2] "{{count}} porten signatures d'altres persones"

#. Cuántos documentos del lote ya firmó la persona con el certificado elegido.
msgid "sede.received.signedByYouCount"
msgid_plural "sede.received.signedByYouCount"
msgstr[0] "{{count}} el vas signar tu amb aquest certificat"
msgstr[1] "{{count}} porten la teva signatura amb aquest certificat"
msgstr[2] "{{count}} porten la teva signatura amb aquest certificat"

#. Cuántos documentos del lote ya firmó la persona con otro certificado suyo: mismo titular y misma entidad representada.
msgid "sede.received.signedByYouOtherCertificateCount"
msgid_plural "sede.received.signedByYouOtherCertificateCount"
msgstr[0] "{{count}} el vas signar tu amb un altre certificat teu"
msgstr[1] "{{count}} porten la teva signatura amb un altre certificat teu"
msgstr[2] "{{count}} porten la teva signatura amb un altre certificat teu"

#. Un solo documento, con alguna firma caducada o no válida, o algún hallazgo.
msgid "sede.received.troubledOne"
msgstr "Té una signatura que no és vàlida"

#. Cuántos documentos del lote tienen alguna firma caducada o no válida, o algún hallazgo.
msgid "sede.received.troubledCount"
msgid_plural "sede.received.troubledCount"
msgstr[0] "{{count}} té una signatura que no és vàlida"
msgstr[1] "{{count}} tenen una signatura que no és vàlida"
msgstr[2] "{{count}} tenen una signatura que no és vàlida"

#. El nombre accesible de la franja de firmas que ya trae el documento, sobre el visor.
msgid "sede.signatures.region"
msgstr "Signatures que ja té"

msgid "sede.signatures.valid"
msgid_plural "sede.signatures.valid"
msgstr[0] "1 vàlida"
msgstr[1] "{{count}} vàlides"
msgstr[2] "{{count}} vàlides"

msgid "sede.signatures.expired"
msgid_plural "sede.signatures.expired"
msgstr[0] "1 caducada"
msgstr[1] "{{count}} caducades"
msgstr[2] "{{count}} caducades"

msgid "sede.signatures.invalid"
msgid_plural "sede.signatures.invalid"
msgstr[0] "1 no vàlida"
msgstr[1] "{{count}} no vàlides"
msgstr[2] "{{count}} no vàlides"

msgid "sede.signatures.show"
msgstr "Veure signatures"

msgid "sede.signatures.hide"
msgstr "Amagar signatures"

#. El botón del pie que abre la vista ampliada con el visor del documento o los documentos.
msgid "sede.consent.viewDocuments"
msgid_plural "sede.consent.viewDocuments"
msgstr[0] "Veure el document"
msgstr[1] "Veure els documents"
msgstr[2] "Veure els documents"

#. El botón del pie de la vista ampliada cuando la sede firma con su servidor trifásico.
msgid "sede.consent.viewSentDocuments"
msgid_plural "sede.consent.viewSentDocuments"
msgstr[0] "Veure el document enviat"
msgstr[1] "Veure els documents enviats"
msgstr[2] "Veure els documents enviats"

#. El botón del pie que pliega la vista ampliada y vuelve a la compacta.
msgid "sede.consent.hideDocuments"
msgstr "Amagar"
