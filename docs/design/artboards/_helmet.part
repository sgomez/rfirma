<helmet>
  <style>
@import url("https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&display=swap");

:root, [data-theme="light"] {
  --rf-bg:#ffffff; --rf-surface:#fafbfc; --rf-text:#000000; --rf-text-muted:#64748b;
  --rf-primary:#64748b; --rf-on-primary:#ffffff; --rf-primary-hover:#475569;
  --rf-accent:#94a3b8; --rf-border-subtle:#e5e5e5; --rf-border-strong:#64748b;
  --rf-focus-ring:#64748b; --rf-scrim:rgba(0,0,0,.6);
}
@media (prefers-color-scheme: dark) {
  :root:not([data-theme="light"]) {
    --rf-bg:#18181b; --rf-surface:#15171a; --rf-text:#ffffff; --rf-text-muted:#94a3b8;
    --rf-primary:#94a3b8; --rf-on-primary:#18181b; --rf-primary-hover:#b6c0cd;
    --rf-accent:#64748b; --rf-border-subtle:rgba(229,229,229,.12);
    --rf-border-strong:rgba(229,229,229,.45); --rf-focus-ring:#94a3b8;
  }
}
[data-theme="dark"] {
  --rf-bg:#18181b; --rf-surface:#15171a; --rf-text:#ffffff; --rf-text-muted:#94a3b8;
  --rf-primary:#94a3b8; --rf-on-primary:#18181b; --rf-primary-hover:#b6c0cd;
  --rf-accent:#64748b; --rf-border-subtle:rgba(229,229,229,.12);
  --rf-border-strong:rgba(229,229,229,.45); --rf-focus-ring:#94a3b8;
}
:root {
  --rf-space-xs:8px; --rf-space-sm:16px; --rf-space-md:24px;
  --rf-space-lg:48px; --rf-space-xl:80px; --rf-space-2xl:144px;
  --rf-radius-sm:4px; --rf-radius-md:6px; --rf-radius-lg:8px;
  --rf-radius-xl:16px; --rf-radius-pill:9999px;
  --rf-shadow-card:rgba(0,0,0,0) 0px 0px 0px 0px, rgba(0,0,0,0) 0px 0px 0px 0px, rgba(0,0,0,.1) 0px 0px 1px 0px, rgba(0,0,0,.03) 0px 2px 6px 0px;
  --rf-shadow-elevated:rgba(0,0,0,0) 0px 0px 0px 0px, rgba(0,0,0,0) 0px 0px 0px 0px, rgba(0,0,0,.1) 0px 20px 25px -5px, rgba(0,0,0,.1) 0px 8px 10px -6px;
  --rf-duration-fast:150ms; --rf-duration-base:300ms;
  --rf-easing:cubic-bezier(.4,0,.2,1);
  --rf-font-body:"Inter",system-ui,-apple-system,"Segoe UI",sans-serif;
}
* { box-sizing:border-box; }
html,body { margin:0; height:100%; }
a { color:var(--rf-text); } a:hover { color:var(--rf-primary-hover); }
:where([data-theme]) { background:var(--rf-bg); }
.rf-root {
  background:var(--rf-bg); color:var(--rf-text);
  font-family:var(--rf-font-body); height:100%;
  -webkit-font-smoothing:antialiased;
}
.rf-root :focus-visible { outline:2px solid var(--rf-focus-ring); outline-offset:2px; }
.rf-display{font-size:96px;line-height:1;font-weight:700;letter-spacing:-2.4px;margin:0}
.rf-heading{font-size:48px;line-height:1.15;font-weight:700;margin:0}
.rf-title{font-size:20px;line-height:1.3;font-weight:700;margin:0}
.rf-body{font-size:12px;line-height:1;font-weight:400;margin:0}
.rf-prose{font-size:14px;line-height:1.6;font-weight:400;margin:0}
.rf-text-muted{color:var(--rf-text-muted)}
.rf-text-primary{color:var(--rf-primary)}
.rf-stack{display:flex;flex-direction:column}
.rf-row{display:flex;flex-direction:row;align-items:center}
.rf-gap-xs{gap:var(--rf-space-xs)} .rf-gap-sm{gap:var(--rf-space-sm)}
.rf-gap-md{gap:var(--rf-space-md)} .rf-gap-lg{gap:var(--rf-space-lg)}
.rf-section{padding:var(--rf-space-md)}
.rf-divider{border:0;border-top:1px solid var(--rf-border-subtle);margin:0;width:100%}
.rf-surface{background:var(--rf-surface)}
.rf-card{display:flex;flex-direction:column;gap:var(--rf-space-xs);
  padding:var(--rf-space-md);background:var(--rf-surface);
  border:1px solid var(--rf-border-subtle);border-radius:var(--rf-radius-md)}
.rf-card--elevated{box-shadow:var(--rf-shadow-elevated)}
.rf-card--interactive{cursor:pointer;transition:border-color var(--rf-duration-fast) var(--rf-easing)}
.rf-card--interactive:hover{border-color:var(--rf-border-strong)}
.rf-btn{display:inline-flex;align-items:center;justify-content:center;gap:var(--rf-space-xs);
  min-height:44px;padding:0 var(--rf-space-sm);border-radius:var(--rf-radius-md);
  font-family:inherit;font-size:14px;font-weight:600;cursor:pointer;
  border:1px solid transparent;background:transparent;color:var(--rf-text);
  transition:background-color var(--rf-duration-fast) var(--rf-easing),
             border-color var(--rf-duration-fast) var(--rf-easing),
             color var(--rf-duration-fast) var(--rf-easing)}
.rf-btn--primary{background:var(--rf-primary);color:var(--rf-on-primary)}
.rf-btn--primary:hover{background:var(--rf-primary-hover)}
.rf-btn--secondary{border-color:var(--rf-border-strong);color:var(--rf-text)}
.rf-btn--secondary:hover{border-color:var(--rf-primary-hover);color:var(--rf-primary-hover)}
.rf-btn--ghost{color:var(--rf-text-muted)}
.rf-btn--ghost:hover{color:var(--rf-text)}
.rf-btn[disabled]{opacity:.45;cursor:not-allowed}
.rf-field{display:flex;flex-direction:column;gap:var(--rf-space-xs)}
.rf-label{font-size:12px;line-height:1;font-weight:600;color:var(--rf-text-muted)}
.rf-input{min-height:44px;padding:0 var(--rf-space-sm);font-family:inherit;font-size:14px;
  color:var(--rf-text);background:var(--rf-bg);
  border:1px solid var(--rf-border-strong);border-radius:var(--rf-radius-md)}
.rf-hint{font-size:12px;line-height:1.4;color:var(--rf-text-muted)}
.rf-field--error .rf-input{border-width:2px}
.rf-field--error .rf-hint{font-weight:700;color:var(--rf-text)}
.rf-field--error .rf-hint::before{content:"! ";}
.rf-badge{display:inline-flex;align-items:center;padding:4px var(--rf-space-xs);
  border-radius:var(--rf-radius-pill);border:1px solid var(--rf-border-subtle);
  font-size:12px;line-height:1;font-weight:600;color:var(--rf-text-muted)}
.rf-badge--primary{background:var(--rf-primary);color:var(--rf-on-primary);border-color:transparent}
.rf-scrim{position:absolute;inset:0;background:var(--rf-scrim);
  display:flex;align-items:center;justify-content:center}
.rf-dialog{display:flex;flex-direction:column;gap:var(--rf-space-md);
  padding:var(--rf-space-md);background:var(--rf-bg);
  border:1px solid var(--rf-border-subtle);border-radius:var(--rf-radius-xl);
  box-shadow:var(--rf-shadow-elevated);width:420px}
</style>
</helmet>
