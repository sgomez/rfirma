<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>es.gob.afirma</groupId>
  <artifactId>rfirma-native-bridge</artifactId>
  <version>0.1.0</version>
  <packaging>jar</packaging>

  <name>rfirma-native-bridge</name>
  <description>Puente GraalVM de rFirma: prefirma y postfirma PAdES trifasicas</description>

  <properties>
    <!-- release 21 A PROPOSITO (ID-12): el JDK que CONSTRUYE es GraalVM CE 25
         —la linea 21 aborta dentro del JNI_OnLoad de libawt.so con cualquier
         firma visible—, pero el lenguaje de destino no se mueve. -->
    <maven.compiler.release>21</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <autofirma.version>1.9.2</autofirma.version>
    <junit.version>5.11.4</junit.version>

    <!-- Las pruebas de grada C (ADR-0014) necesitan poppler (`pdfsig`), que el
         carril rapido no instala. Se EXCLUYEN por omision y el carril lento las
         activa con -DexcludedGroups= (lo hace `just test-native`). Compilarlas
         no depende de esto: `mvn test` las compila siempre, que es el punto
         ciego que cierra la TD-02. -->
    <excludedGroups>gradaC</excludedGroups>
  </properties>

  <dependencies>
    <!-- El nucleo trifasico, del que solo se instancia PAdESTriPhasePreProcessor
         (NO PreProcessorFactory: esa referencia los preprocesadores XAdES,
         FacturaE, ASiC y PKCS1, y haria alcanzable todo el arbol de formatos). -->
    <dependency>
      <groupId>es.gob.afirma</groupId>
      <artifactId>afirma-server-triphase-signer-core</artifactId>
      <version>${autofirma.version}</version>
      <exclusions>
        <!-- ADR-0012 / ID-08: ESTA EXCLUSION NO SE QUITA. La rubrica la
             normaliza Rust. afirma-crypto-pdf declara afirma-ui-utils con
             <scope>runtime</scope> y lo invoca por reflexion en
             PdfPreProcessor.getImage:304; al no estar la clase, el
             catch (Throwable) de la linea 309 degrada a "se agrega tal cual" y
             javax.imageio.ImageIO deja de ser alcanzable. Eso es lo que deja la
             imagen nativa en UN SOLO fichero de 27,7 MB en vez de seis.
             Y no es solo tamano (ID-09): si libawt.so acaba al lado de la
             libreria, un JPEG con perfil ICC ABORTA el proceso (rc=134) en vez
             de dar un error recuperable. Medido en el issue #36:
             docs/research/exclusion-afirma-ui-utils.md. -->
        <exclusion>
          <groupId>es.gob.afirma</groupId>
          <artifactId>afirma-ui-utils</artifactId>
        </exclusion>
      </exclusions>
    </dependency>

    <!-- PAdES trifasico llama LITERALMENTE a CAdESTriPhaseSigner: la prefirma
         PAdES devuelve atributos firmados CAdES (ID-15) y la postfirma
         reensambla la firma CAdES dentro del PDF. Llega ya como transitiva de
         afirma-crypto-pdf, pero se declara explicita porque el puente depende
         de ella de verdad y una transitiva puede desaparecer sin aviso.
         Verificado en docs/research/pades-triphase-contract.md, pregunta 6. -->
    <dependency>
      <groupId>es.gob.afirma</groupId>
      <artifactId>afirma-crypto-cades</artifactId>
      <version>${autofirma.version}</version>
      <exclusions>
        <exclusion>
          <groupId>es.gob.afirma</groupId>
          <artifactId>afirma-ui-utils</artifactId>
        </exclusion>
      </exclusions>
    </dependency>

    <!-- El motor de filtros de certificado del original (ID-252). NO lleva
         exclusion de afirma-ui-utils, y no es un olvido: medido en el #350, este
         modulo no la arrastra —su unica dependencia es afirma-core-keystores—,
         la imagen nativa engorda un 2,4 % (27 723 872 -> 28 379 232 B) y los 47
         metodos de AWT alcanzables que quedan son de iText y ya estaban. La
         exclusion de las dos dependencias de arriba SIGUE HACIENDO FALTA.
         Del modulo se toma el MOTOR, no el parseo: la lista blanca de criterios
         se aplica en Rust (protocol/filters.rs) antes de llamar aqui. -->
    <dependency>
      <groupId>es.gob.afirma</groupId>
      <artifactId>afirma-keystores-filters</artifactId>
      <version>${autofirma.version}</version>
    </dependency>

    <!-- afirma-core-keystores EXPLICITO, y no por gusto: el pom publicado de
         afirma-keystores-filters:1.9.2 pide a su hermano
         ${clienteafirma.version}, y esa propiedad vale 1.9 en el POM padre del
         tag v1.9.2 (la misma trampa que documenta el CLAUDE.md para el
         bootstrap). Sin esta linea, `mvn dependency:tree` baja
         afirma-core-keystores:1.9 —cuyo pom ni siquiera esta en la cache— y el
         puente compilaria contra la 1.9 EN SILENCIO. Aqui vive
         CertificateFilter, que es lo que devuelve el motor. -->
    <dependency>
      <groupId>es.gob.afirma</groupId>
      <artifactId>afirma-core-keystores</artifactId>
      <version>${autofirma.version}</version>
    </dependency>

    <dependency>
      <groupId>org.graalvm.sdk</groupId>
      <artifactId>graal-sdk</artifactId>
      <version>23.1.0</version>
      <scope>provided</scope>
    </dependency>

    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>${junit.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.13.0</version>
        <configuration>
          <compilerArgs>
            <!-- Todos los avisos del compilador activos: es todo el linting
                 que hoy tiene sentido en esta cadena (ADR-0014). -->
            <arg>-Xlint:all</arg>
          </compilerArgs>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.5.2</version>
        <configuration>
          <excludedGroups>${excludedGroups}</excludedGroups>
          <systemPropertyVariables>
            <java.util.logging.config.file>${project.basedir}/src/test/resources/logging.properties</java.util.logging.config.file>
          </systemPropertyVariables>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-dependency-plugin</artifactId>
        <version>3.6.1</version>
        <executions>
          <execution>
            <id>build-classpath</id>
            <phase>package</phase>
            <goals><goal>build-classpath</goal></goals>
            <configuration>
              <outputFile>${project.build.directory}/cp.txt</outputFile>
              <includeScope>runtime</includeScope>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
