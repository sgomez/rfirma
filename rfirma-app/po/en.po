msgid "errors.technicalDetail"
msgstr "Technical detail"

msgid "errors.situations.unknown.title"
msgstr "The operation could not be completed"

msgid "errors.situations.unknown.body"
msgstr ""
"Try again. If it keeps happening, attach the technical detail to the bug "
"report."

msgid "errors.situations.notAnAcceptedImage.title"
msgstr "That image cannot be used as a rubric"

msgid "errors.situations.notAnAcceptedImage.body"
msgstr "The rubric has to be a PNG or a JPEG."

msgid "errors.situations.damagedImage.title"
msgstr "The image could not be opened"

msgid "errors.situations.damagedImage.body"
msgstr "The file is a PNG or a JPEG, but it is damaged. Try another copy."

msgid "errors.situations.imageTooLarge.title"
msgstr "The image is too large"

msgid "errors.situations.imageTooLarge.body"
msgstr "Choose a smaller image, or save it at a lower resolution."

msgid "errors.situations.sourceUnreadable.title"
msgstr "The file you chose could not be read"

msgid "errors.situations.sourceUnreadable.body"
msgstr "Check that it is still where it was and choose it again."

msgid "errors.situations.storeUnwritable.title"
msgstr "Your rubric could not be saved"

msgid "errors.situations.storeUnwritable.body"
msgstr ""
"Choose the image again. If it keeps happening, attach the technical detail "
"to the bug report."

msgid "errors.situations.storeUnreadable.title"
msgstr "Your saved rubric could not be read"

msgid "errors.situations.storeUnreadable.body"
msgstr "Choose the image again to replace it."

msgid "errors.situations.incorrectPin.title"
msgstr "The PIN is not correct"

msgid "errors.situations.incorrectPin.body"
msgstr "Type it again. The card locks after a few failed attempts."

msgid "errors.situations.pinLocked.title"
msgstr "The card is locked"

msgid "errors.situations.pinLocked.body"
msgstr ""
"It locked after too many failed PIN attempts. Unlock it with its PUK before "
"signing again."

msgid "errors.situations.tokenAbsent.title"
msgstr "We cannot find the card"

msgid "errors.situations.tokenAbsent.body"
msgstr ""
"Check that it is still inserted and that the reader is connected, then try "
"again."

msgid "errors.situations.expiredSession.title"
msgstr "The session with the card expired"

msgid "errors.situations.expiredSession.body"
msgstr ""
"Try again: a new session will be opened and we will ask for the PIN once "
"more."

msgid "errors.situations.moduleNotFound.title"
msgstr "The card module could not be loaded"

msgid "errors.situations.moduleNotFound.body"
msgstr ""
"Check that the PKCS#11 module is where you said it was, or choose another "
"one."

msgid "errors.situations.certificateNotFound.title"
msgstr "The certificate is no longer on the card"

msgid "errors.situations.certificateNotFound.body"
msgstr "Look for the certificates again and choose one of those that turn up."

msgid "errors.situations.certificateExpired.title"
msgstr "The certificate has expired"

msgid "errors.situations.certificateExpired.body"
msgstr ""
"An expired certificate cannot sign. Renew it with its issuer and try again."

msgid "errors.situations.certificateNotYetValid.title"
msgstr "The certificate is not valid yet"

msgid "errors.situations.certificateNotYetValid.body"
msgstr "Its validity period has not started, so it cannot sign."

msgid "errors.situations.certificateRevoked.title"
msgstr "The certificate is revoked"

msgid "errors.situations.certificateRevoked.body"
msgstr "Its issuer revoked it, so it cannot sign. You need a new one."

msgid "errors.situations.certificateUnreadable.title"
msgstr "The certificate could not be read"

msgid "errors.situations.certificateUnreadable.body"
msgstr "What is on the card is not a certificate we can read. Try another one."

msgid "errors.situations.notAPdf.title"
msgstr "That file is not a PDF"

msgid "errors.situations.notAPdf.body"
msgstr "rFirma signs PDFs. Choose a PDF document and try again."

msgid "errors.situations.documentEncrypted.title"
msgstr "The PDF is protected"

msgid "errors.situations.documentEncrypted.body"
msgstr ""
"It is encrypted or has restricted permissions, so it cannot be signed. Open "
"it with its password, save it without protection and try again."

msgid "errors.situations.documentCertified.title"
msgstr "The PDF is certified"

msgid "errors.situations.documentCertified.body"
msgstr ""
"Its author signed it forbidding changes, so adding a signature would "
"invalidate theirs. Ask them for an uncertified copy."

msgid "errors.situations.documentUnreadable.title"
msgstr "The document could not be read"

msgid "errors.situations.documentUnreadable.body"
msgstr "Check that it is still where it was and open it again."

msgid "errors.situations.droppedFileUnreadable.title"
msgstr "We could not read the file you dropped"

msgid "errors.situations.droppedFileUnreadable.body"
msgstr ""
"Dropping a file does not give us permission to read from every folder. Open "
"it with the open button, which does."

msgid "errors.situations.droppedOnlyFirst.title"
msgstr "We only opened the first PDF"

msgid "errors.situations.droppedOnlyFirst.body"
msgstr ""
"rFirma signs one document at a time. The other files you dropped are still "
"where they were: drop them once you are done with this one."

msgid "errors.situations.boxOutOfPage.title"
msgstr "The box falls outside the page"

msgid "errors.situations.boxOutOfPage.body"
msgstr ""
"Drag it inside the page and sign again. Left as it is, it would be clipped "
"in the PDF without warning."

msgid "errors.situations.pageOutOfDocument.title"
msgstr "The document does not reach that page"

msgid "errors.situations.pageOutOfDocument.body"
msgstr ""
"Choose a page the document actually has and sign again. Left as it is, the "
"seal would end up on the last page without warning."

msgid "errors.situations.sealMismatch.title"
msgstr "Signing was interrupted halfway"

msgid "errors.situations.sealMismatch.body"
msgstr ""
"What we prepared at the start and what came back at the end do not match, so "
"we stopped before writing anything. Sign the document again."

msgid "errors.situations.bridgeFailed.title"
msgstr "The signature could not be prepared"

msgid "errors.situations.bridgeFailed.body"
msgstr ""
"The component that assembles the signed PDF failed. Try again and, if it "
"keeps happening, attach the technical detail to the bug report."

msgid "errors.situations.folderMissing.title"
msgstr "The destination folder is gone"

msgid "errors.situations.folderMissing.body"
msgstr ""
"We do not create it for you: if we did, the document would look saved and "
"would not be there. Create it again or choose another one in Preferences."

msgid "errors.situations.notAFolder.title"
msgstr "The destination is not a folder"

msgid "errors.situations.notAFolder.body"
msgstr ""
"There is a file with that name where we expected a folder. Choose another "
"destination in Preferences."

msgid "errors.situations.folderUnreadable.title"
msgstr "The destination folder could not be checked"

msgid "errors.situations.folderUnreadable.body"
msgstr ""
"It may be a permissions problem or a drive that is not responding. Choose "
"another destination in Preferences."

msgid "errors.situations.folderUnwritable.title"
msgstr "The signed document could not be saved"

msgid "errors.situations.folderUnwritable.body"
msgstr ""
"Signing worked, but the file could not be written to the destination folder. "
"Choose another one in Preferences and sign again."

msgid "errors.situations.noFreeName.title"
msgstr "There are already too many documents with that name"

msgid "errors.situations.noFreeName.body"
msgstr ""
"We stopped rather than overwrite one. Move or rename the earlier ones and "
"sign again."

msgid "errors.situations.settingNotSaved.title"
msgstr "The setting could not be saved"

msgid "errors.situations.settingNotSaved.body"
msgstr ""
"We went back to the previous value, which is the one still saved. Try again "
"and, if it keeps happening, attach the technical detail to the bug report."

msgid "errors.situations.activityNotForgotten.title"
msgstr "The list could not be emptied"

msgid "errors.situations.activityNotForgotten.body"
msgstr ""
"Your recent documents and your certificate are still saved. Try again and, "
"if it keeps happening, attach the technical detail to the bug report."

