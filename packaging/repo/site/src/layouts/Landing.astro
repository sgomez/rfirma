---
import Comparison from "../components/Comparison.astro";
import Footer from "../components/Footer.astro";
import Formats from "../components/Formats.astro";
import Hero from "../components/Hero.astro";
import HowToSign from "../components/HowToSign.astro";
import Install from "../components/Install.astro";
import Nav from "../components/Nav.astro";
import NoticeTop from "../components/NoticeTop.astro";
import Pillars from "../components/Pillars.astro";
import Transparency from "../components/Transparency.astro";
import { defaultLocale, localePath, locales, openGraphLocales, translator, type Locale } from "../i18n";
import "../styles/landing.css";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = translator(locale);
const canonical = new URL(localePath(locale), Astro.site);
const image = new URL("/og.png", Astro.site);
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{t("meta.title")}</title>
    <meta name="description" content={t("meta.description")} />
    <link rel="canonical" href={canonical.href} />
    {
      locales.map((other) => (
        <link rel="alternate" hreflang={other} href={new URL(localePath(other), Astro.site).href} />
      ))
    }
    <link rel="alternate" hreflang="x-default" href={new URL(localePath(defaultLocale), Astro.site).href} />
    <meta property="og:site_name" content="rFirma" />
    <meta property="og:title" content={t("meta.title")} />
    <meta property="og:description" content={t("footer.tagline")} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:locale" content={openGraphLocales[locale]} />
    {
      locales
        .filter((other) => other !== locale)
        .map((other) => <meta property="og:locale:alternate" content={openGraphLocales[other]} />)
    }
    <meta property="og:image" content={image.href} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={t("meta.image.alt")} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={t("meta.title")} />
    <meta name="twitter:description" content={t("footer.tagline")} />
    <meta name="twitter:image" content={image.href} />
    <meta name="twitter:image:alt" content={t("meta.image.alt")} />
    <meta name="theme-color" content="#067781" />
  </head>
  <body>
    <div class="rf-root landing" data-theme="light">
      <NoticeTop locale={locale} />
      <Nav locale={locale} />
      <main>
        <Hero locale={locale} />
        <Formats locale={locale} />
        <HowToSign locale={locale} />
        <Pillars locale={locale} />
        <Comparison locale={locale} />
        <Install locale={locale} />
        <Transparency locale={locale} />
      </main>
      <Footer locale={locale} />
    </div>

    <script>
      import { mountCopyButton } from "../scripts/copy-to-clipboard";
      import { mountGuidedDemo } from "../scripts/guided-demo";
      import { mountInstallTabs } from "../scripts/install-tabs";
      import { mountMockScale } from "../scripts/mock-scale";
      import { mountReveal } from "../scripts/reveal";

      const MOCK_WIDTH = 1000;
      const MOCK_HEIGHT = 620;

      const frame = document.querySelector<HTMLElement>("[data-mock-frame]");
      const stage = document.querySelector<HTMLElement>("[data-mock-stage]");
      if (frame && stage) {
        mountMockScale(frame, stage, MOCK_WIDTH, MOCK_HEIGHT);
      }

      const demo = document.querySelector<HTMLElement>(".demo");
      if (demo) {
        mountGuidedDemo(demo);
      }

      const tablist = document.querySelector<HTMLElement>("[data-install-tablist]");
      if (tablist) {
        mountInstallTabs(tablist, Array.from(document.querySelectorAll<HTMLElement>("[role='tabpanel']")));
      }

      for (const button of document.querySelectorAll<HTMLElement>("[data-copy-for]")) {
        const code = document.getElementById(button.dataset.copyFor ?? "");
        if (code) {
          mountCopyButton(button, code);
        }
      }

      mountReveal(Array.from(document.querySelectorAll<HTMLElement>("[data-reveal]")));
    </script>
  </body>
</html>
