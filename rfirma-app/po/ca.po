msgid "actions.close"
msgstr "Tancar"

msgid "actions.change"
msgstr "Canviar"

msgid "actions.remove"
msgstr "Treure"

msgid "actions.dismiss"
msgstr "Descartar"

msgid "actions.copy"
msgstr "Copiar"

msgid "actions.back"
msgstr "Tornar"

