msgid "errors.technicalDetail"
msgstr "Technical detail"

msgid "errors.reload"
msgstr "Reload the window"

#. El botón que ofrece vaciar el Almacén de rFirma cuando el llavero perdió su PIN (ADR-0034).
msgid "errors.emptyStore.button"
msgstr "Empty the store"

msgid "errors.emptyStore.confirmQuestion"
msgstr ""
"Are you sure? The installed certificates will be lost, and this can't be "
"undone."

#. El botón que copia el detalle técnico crudo del error de firma.
msgid "errors.copyDetail"
msgstr "Copy detail"

#. Añade la tranquilidad de que nada se ha guardado, junto a un fallo ya clasificado.
msgid "errors.documentUnchanged"
msgstr "The document is unchanged: nothing has been saved."

#. El título fijo del error de firma (docs/design/panel-de-firma.md § Estados
#. → Error al firmar); la situación clasificada baja a ser la causa.
msgid "errors.signingFailedTitle"
msgstr "Signing failed"

#. Mensaje genérico: reintentar. Lo usan unknown, expiredSession, sealMismatch, bridgeFailed, settingNotSaved, activityNotForgotten, handlerListUnreadable y handlerListUnwritable.
msgid "errors.messages.retry.title"
msgstr "Something went wrong"

#. «Comentarios y ayuda» es header.help, el botón que sale debajo.
msgid "errors.messages.retry.body"
msgstr ""
"Try again. If it keeps happening, share the technical detail in “Feedback "
"and help”."

msgid "errors.messages.handlerNotAvailable.title"
msgstr "We can't change who opens these links"

msgid "errors.messages.handlerNotAvailable.body"
msgstr ""
"This build of rFirma can't write that choice: change it in your desktop "
"settings."

#. Mensaje genérico: elegir otra imagen de rúbrica. Lo usan notAnAcceptedImage, damagedImage, imageTooLarge, sourceUnreadable, storeUnwritable y storeUnreadable.
msgid "errors.messages.otherImage.title"
msgstr "The image couldn't be used"

msgid "errors.messages.otherImage.body"
msgstr "Choose a PNG or JPEG that isn't too large."

msgid "errors.messages.incorrectPin.title"
msgstr "The PIN isn't correct"

msgid "errors.messages.incorrectPin.body"
msgstr "The card locks after a few failed attempts."

msgid "errors.messages.pinLocked.title"
msgstr "The card is locked"

msgid "errors.messages.pinLocked.body"
msgstr "Unlock it with the PUK."

#. Mensaje genérico: revisar la tarjeta y volver a buscar. Lo usan tokenAbsent y certificateNotFound.
msgid "errors.messages.checkToken.title"
msgstr "The card or certificate is missing"

msgid "errors.messages.checkToken.body"
msgstr "Check the card and the reader, then search again."

msgid "errors.messages.moduleNotFound.title"
msgstr "The card module couldn't be loaded"

msgid "errors.messages.moduleNotFound.body"
msgstr "Check its path or choose another module."

msgid "errors.messages.certificateExpired.title"
msgstr "Your certificate has expired"

msgid "errors.messages.certificateExpired.body"
msgstr "Renew it with its issuer."

#. Mensaje genérico de un solo renglón, sin cuerpo: elegir otro certificado. Lo usan certificateRevoked, certificateNotYetValid, certificateUnreadable, keyKindUnsupported y mechanismNotOffered.
msgid "errors.messages.otherCertificate.title"
msgstr "That certificate can't be used to sign"

#. Mensaje genérico: elegir otro fichero .p12 o .pfx. Lo usan pkcs12Unreadable y pkcs12NoPrivateKey.
msgid "errors.messages.otherCertificateFile.title"
msgstr "That file isn't usable as a certificate"

msgid "errors.messages.otherCertificateFile.body"
msgstr "Choose a .p12 or .pfx file with its private key."

#. Un solo renglón, sin cuerpo.
msgid "errors.messages.incorrectPkcs12Password.title"
msgstr "That password isn't right"

msgid "errors.messages.removalNotSupported.title"
msgstr "This certificate can't be removed on its own"

msgid "errors.messages.removalNotSupported.body"
msgstr "Removing it would delete all certificates in the rFirma Store."

#. Un solo renglón, sin cuerpo.
msgid "errors.messages.notAPdf.title"
msgstr "That file isn't a PDF"

msgid "errors.messages.documentEncrypted.title"
msgstr "The PDF is protected"

msgid "errors.messages.documentEncrypted.body"
msgstr "Save it without protection and open it again."

#. Es el aviso de seguridad: en la tarjeta de error de firma y en la ventana de sede solo se ve el título.
msgid "errors.messages.documentCertified.title"
msgstr "Signing it would invalidate the author's certification"

msgid "errors.messages.documentCertified.body"
msgstr "Ask the author for an uncertified copy."

#. Mensaje genérico: volver a abrir el documento. Lo usan documentUnreadable y droppedFileUnreadable.
msgid "errors.messages.reopenDocument.title"
msgstr "The document couldn't be read"

msgid "errors.messages.reopenDocument.body"
msgstr "Open it again with “Open PDF…”."

msgid "errors.messages.droppedSomeDiscarded.title"
msgstr "Some files weren't added"

msgid "errors.messages.droppedSomeDiscarded.body"
msgstr "Only PDFs are opened."

#. Mensaje genérico de un solo renglón, sin cuerpo: recolocar la firma visible. Lo usan boxOutOfPage y pageOutOfDocument.
msgid "errors.messages.moveVisibleSignature.title"
msgstr "The visible signature falls outside the document"

msgid "errors.messages.renderFailed.title"
msgstr "This screen stopped working"

msgid "errors.messages.renderFailed.body"
msgstr "Reload the window to continue."

#. Mensaje genérico: elegir otra carpeta de destino. Lo usan folderMissing, notAFolder, folderUnreadable y folderUnwritable.
msgid "errors.messages.otherFolder.title"
msgstr "The destination folder isn't available"

msgid "errors.messages.otherFolder.body"
msgstr "Choose another one in Preferences and sign again."

msgid "errors.messages.noFreeName.title"
msgstr "There are too many documents with that name"

msgid "errors.messages.noFreeName.body"
msgstr "Move or rename the earlier ones and sign again."

msgid "errors.messages.noKeyring.title"
msgstr "The desktop keyring isn't responding"

msgid "errors.messages.noKeyring.body"
msgstr "Unlock it or check that your desktop has one, then try again."

msgid "errors.messages.keyringPinMissing.title"
msgstr "The keyring lost the Store PIN"

msgid "errors.messages.keyringPinMissing.body"
msgstr ""
"Empty the Store in Preferences → Certificates and install your certificates "
"again."

#. Nombre accesible de la región para lectores de pantalla, no un título visible.
msgid "window.viewer"
msgstr "Document viewer"

#. Nombre accesible de la región para lectores de pantalla, no un título visible.
msgid "window.panel"
msgstr "Signature panel"

#. Lleva a «Acerca de», donde están las órdenes de alta del repositorio.
msgid "notifications.newVersion.action"
msgstr "How to update"

msgid "updates.install.action"
msgstr "Update now"

msgid "updates.install.confirmTitle"
msgstr "Update to version {{version}}?"

#. El botón de al lado, «Instalar y cerrar», ya avisa de que rFirma se cierra.
msgid "updates.install.confirmBody"
msgstr "Finish what you're doing first."

msgid "updates.install.confirm"
msgstr "Install and close"

msgid "updates.install.installing"
msgstr "Installing the update…"

msgid "updates.install.failedTitle"
msgstr "The update could not be installed"

msgid "updates.install.failed.noUpdate"
msgstr "There's no longer a new version."

msgid "updates.install.failed.networkFailure"
msgstr "Check your connection and try again."

msgid "updates.install.failed.invalidSignature"
msgstr "The download doesn't have a valid signature."

msgid "updates.install.failed.notAvailable"
msgstr "This installation can't be updated from rFirma."

msgid "header.menu"
msgstr "Menu"

#. Nombre accesible y tooltip del botón de aviso de la cabecera.
msgid "header.attention"
msgstr "rFirma Status: needs attention"

msgid "header.preferences"
msgstr "Preferences…"

msgid "header.help"
msgstr "Feedback and help"

msgid "header.about"
msgstr "About rFirma"

msgid "badges.signed"
msgstr "Signed"

#. Nombre accesible de la tira de pestañas, no un título visible.
msgid "tabs.label"
msgstr "Open documents"

msgid "tabs.more"
msgstr "More tabs"

#. {{name}} es el nombre del fichero de la pestaña.
msgid "tabs.close"
msgstr "Close {{name}}"

#. Título de la pestaña de otro documento mientras una firma está en curso.
msgid "tabs.lockedWhileSigning"
msgstr "Wait for the signature to finish."

#. Texto del segmento principal del botón partido de abrir.
msgid "tabs.openPdf"
msgstr "Open PDF…"

#. Título del segmento principal del botón partido: anuncia el atajo.
msgid "tabs.openPdfShortcut"
msgstr "Ctrl+O"

#. Encabezado de la lista de recientes y nombre accesible de la flecha del botón partido que la despliega.
msgid "recents.heading"
msgstr "Recently opened"

msgid "recents.clear"
msgstr "Clear the list"

msgid "recents.open"
msgstr "Open"

msgid "recents.goToTab"
msgstr "Go to its tab"

msgid "recents.missing"
msgstr "Not found"

msgid "recents.today"
msgstr "today"

msgid "recents.yesterday"
msgstr "yesterday"

msgid "viewer.dropZone"
msgstr "Drag a PDF here, or click to open one"

msgid "viewer.dropZoneHint"
msgstr "It never leaves your computer"

msgid "viewer.noPreview"
msgstr "No preview"

msgid "viewer.pageNumber"
msgstr "Page number"

#. {{total}} es el número de páginas del documento.
msgid "viewer.pageOf"
msgstr "of {{total}}"

msgid "viewer.firstPage"
msgstr "First page"

msgid "viewer.previousPage"
msgstr "Previous page"

msgid "viewer.nextPage"
msgstr "Next page"

msgid "viewer.lastPage"
msgstr "Last page"

msgid "viewer.zoomOut"
msgstr "Zoom out"

msgid "viewer.zoomIn"
msgstr "Zoom in"

#. Rótulo del campo donde se teclea el porcentaje de zoom.
msgid "viewer.zoomLevel"
msgstr "Zoom level"

#. Botón: la hoja ocupa todo el ancho disponible.
msgid "viewer.fitWidth"
msgstr "Fit width"

#. Botón: la página entera cabe en el visor.
msgid "viewer.fitPage"
msgstr "Fit page"

#. Nombre accesible de la hoja del documento, que se enfoca para pasar de página.
msgid "viewer.sheet"
msgstr "Document sheet"

msgid "viewer.signatureBox"
msgstr "Visible signature box"

msgid "viewer.dragHandle"
msgstr "Drag to place"

msgid "viewer.outOfPage"
msgstr "The box can't go off the page."

msgid "viewer.stamp.onDemand"
msgstr "The document is large: the visible signature isn't redrawn on its own"

msgid "viewer.stamp.show"
msgstr "See how it looks"

msgid "viewer.stamp.composing"
msgstr "Composing the visible signature…"

msgid "viewer.stamp.failed"
msgstr "We couldn't draw the visible signature"

msgid "panel.document.pages"
msgid_plural "panel.document.pages"
msgstr[0] "1 page"
msgstr[1] "{{count}} pages"
msgstr[2] "{{count}} pages"

#. Línea del aviso de firmas previas: con cuántas firmas se firma.
msgid "panel.previousSignatures.alongside"
msgid_plural "panel.previousSignatures.alongside"
msgstr[0] "Alongside 1 signature"
msgstr[1] "Alongside {{count}} signatures"
msgstr[2] "Alongside {{count}} signatures"

#. Coletilla del aviso de firmas previas: cuántas están caducadas, si ninguna es no válida.
msgid "panel.previousSignatures.expired"
msgid_plural "panel.previousSignatures.expired"
msgstr[0] "1 expired"
msgstr[1] "{{count}} expired"
msgstr[2] "{{count}} expired"

#. Coletilla del aviso de firmas previas: cuántos problemas hay, con alguna no válida o un hallazgo.
msgid "panel.previousSignatures.problems"
msgid_plural "panel.previousSignatures.problems"
msgstr[0] "1 problem"
msgstr[1] "{{count}} problems"
msgstr[2] "{{count}} problems"

#. Botón del aviso de firmas previas que abre el diálogo de fichas.
msgid "panel.previousSignatures.view"
msgstr "View signatures →"

#. Franja al pie del aviso de firmas previas y título de «Firmar» desactivado: la firma local rechaza el PDF por certificado.
msgid "panel.previousSignatures.closed"
msgstr "The document accepts no further signatures."

#. Franja al pie del aviso de firmas previas: ya firmaste con el certificado elegido.
msgid "panel.previousSignatures.sameCertificate"
msgstr "You already signed this with this certificate"

#. Franja al pie del aviso de firmas previas: ya firmaste, pero con otro certificado tuyo.
msgid "panel.previousSignatures.otherCertificate"
msgstr "You already signed this, with another certificate of yours"

#. Nombre accesible del segmentado que elige en qué páginas va la firma visible.
msgid "panel.placement.title"
msgstr "On which pages"

#. Segmento: la firma visible en una sola página.
msgid "panel.placement.single"
msgstr "One page"

#. Bajo «Una página»: {{page}} es la página donde está el recuadro.
msgid "panel.placement.singlePage"
msgstr "On page {{page}}"

#. Segmento: la firma visible en las páginas que se escriben en el campo.
msgid "panel.placement.these"
msgstr "Several"

#. Nombre del campo donde se teclean las páginas, para quien usa lector de pantalla.
msgid "panel.placement.field"
msgstr "Pages of the visible signature"

#. Segmento: la firma visible en todas las páginas del documento.
msgid "panel.placement.all"
msgstr "All"

#. Botón que pone la firma visible en la página que se está mirando, con «Una página» o «Varias».
msgid "panel.placement.seal"
msgstr "Place it here"

#. Botón que quita la firma visible de la página que se está mirando, cuando ya la lleva.
msgid "panel.placement.unseal"
msgstr "Remove it from here"

#. {{count}} son las páginas del documento; se ha escrito una que no existe.
msgid "panel.placement.errors.beyond"
msgid_plural "panel.placement.errors.beyond"
msgstr[0] "There is only 1 page"
msgstr[1] "There are only {{count}} pages"
msgstr[2] "There are only {{count}} pages"

#. {{entry}} es el rango tal y como se ha escrito, por ejemplo 3-1.
msgid "panel.placement.errors.reversed"
msgstr "“{{entry}}” runs backwards"

msgid "panel.placement.errors.zero"
msgstr "There is no page 0"

#. Lo escrito no se entiende: las páginas y los rangos van separados por comas.
msgid "panel.placement.errors.malformed"
msgstr "Separate the pages with commas"

#. El campo de páginas está vacío: no nombra ninguna, así que no se puede firmar.
msgid "panel.placement.errors.empty"
msgstr "Type the pages"

msgid "panel.certificate.title"
msgstr "Certificate"

msgid "panel.certificate.loading"
msgstr "Looking for certificates…"

#. {{issuer}} es el nombre de la entidad emisora del certificado.
msgid "panel.certificate.issuer"
msgstr "Issued by {{issuer}}"

msgid "panel.certificate.groups.available"
msgstr "Available"

#. Segunda línea de un certificado de representante. {{holder}} es el
#. nombre y apellidos del representante; {{idNumber}}, su DNI o NIE.
msgid "panel.certificate.onBehalfOf"
msgstr "Representative · {{holder}} · {{idNumber}}"

#. Versión corta de la anterior, para la caja cerrada. {{holder}} es el titular.
msgid "panel.certificate.onBehalfOfShort"
msgstr "Representative · {{holder}}"

#. Segunda línea —y su versión corta— de un certificado personal. {{idNumber}}
#. es el DNI o NIE en claro.
msgid "panel.certificate.personalCapacity"
msgstr "On their own behalf · {{idNumber}}"

#. La palabra por la que el buscador del selector encuentra un certificado
#. personal (sin entidad). No se muestra en pantalla, solo se compara.
msgid "panel.certificate.personalKeyword"
msgstr "personal"

#. Nombre propio del navegador: no se traduce.
msgid "panel.certificate.stores.chrome"
msgstr "Chrome"

#. Término del dominio: NSS es el almacén de certificados de Firefox y Chrome; no se traduce la sigla.
msgid "panel.certificate.stores.nssdb"
msgstr "NSS store"

msgid "panel.certificate.stores.installed"
msgstr "Installed in rFirma"

msgid "actions.lookAgain"
msgstr "Look again"

#. {{date}} es «mes/año» de caducidad, ya formateado, para la segunda línea de
#. la fila del botón partido.
msgid "panel.certificate.expiresIn"
msgstr "Expires in {{date}}"

msgid "panel.certificate.empty.title"
msgstr "No certificates"

msgid "panel.certificate.failed.title"
msgstr "We couldn't look for certificates"

#. Frase corta, en negrita, para la tercera línea de una fila no utilizable
#. del botón partido. {{date}} es la fecha de caducidad, ya formateada.
msgid "panel.certificate.expiredShort"
msgstr "Expired on {{date}}"

msgid "panel.certificate.notYetValidShort"
msgstr "Not yet valid"

#. {{reason}} es el motivo de la revocación, tal como lo da el certificado.
msgid "panel.certificate.revokedShort"
msgstr "Revoked ({{reason}})"

msgid "panel.certificate.unreadableShort"
msgstr "Could not be read"

msgid "panel.certificate.chooseOne"
msgstr "Choose a certificate"

msgid "panel.certificate.groups.cannotUse"
msgstr "Cannot be used"

#. Texto de ayuda del buscador del selector de certificado abierto.
msgid "panel.certificate.search"
msgstr "Name, company, tax ID or store"

#. Encabeza la lista filtrada. {{shown}} son los que coinciden; {{total}}, todos.
msgid "panel.certificate.matches"
msgstr "{{shown}} of {{total}}"

msgid "panel.certificate.noMatch"
msgstr "No certificate matches"

#. Ayuda flotante de una fila, tras «Emitido por…». {{stores}} es la lista de
#. almacenes, ya unida según el idioma: «Firefox y Chrome».
msgid "panel.certificate.sameCertificateIn"
msgstr "the same certificate in {{stores}}"

msgid "panel.visibleSignature.title"
msgstr "Visible signature"

#. Aviso bajo «Firma visible» mientras no hay certificado elegido; el interruptor está desactivado.
msgid "panel.visibleSignature.needsCertificate"
msgstr "Choose a certificate first."

#. Título del interruptor de «Firma visible» cuando está apagado.
msgid "panel.visibleSignature.turnOn"
msgstr "Add a visible signature"

#. Título del interruptor de «Firma visible» cuando está encendido.
msgid "panel.visibleSignature.turnOff"
msgstr "Remove the visible signature"

msgid "panel.visibleSignature.model.title"
msgstr "Model"

msgid "panel.visibleSignature.model.complete"
msgstr "Complete"

msgid "panel.visibleSignature.model.rubricOnly"
msgstr "Rubric only"

msgid "panel.visibleSignature.model.custom"
msgstr "Custom"

msgid "panel.visibleSignature.model.rubricOnlyDisabled"
msgstr "Needs the rubric"

msgid "panel.visibleSignature.phrase.label"
msgstr "Signature phrase"

msgid "panel.visibleSignature.phrase.addDatum"
msgstr "Detail"

#. Comienzo de la frase de ejemplo de Personalizada; le sigue el nombre del firmante.
msgid "panel.visibleSignature.phrase.seedLead"
msgstr "Approved by "

#. Separador de la frase de ejemplo entre el firmante y la fecha.
msgid "panel.visibleSignature.phrase.seedJoin"
msgstr ", "

msgid "panel.visibleSignature.rubric.toggle"
msgstr "With rubric"

msgid "panel.visibleSignature.rubric.lockedTitle"
msgstr "Rubric only needs it"

msgid "panel.visibleSignature.rubric.noImageTitle"
msgstr "No rubric loaded"

msgid "panel.visibleSignature.rubric.choose"
msgstr "Load…"

msgid "panel.visibleSignature.rubric.change"
msgstr "Change…"

#. Texto alternativo de la miniatura de la rúbrica cargada.
msgid "panel.visibleSignature.rubric.thumbnail"
msgstr "Your rubric"

msgid "panel.footer.savedIn"
msgstr "Save in"

#. {{folder}} es la ruta corta de la carpeta de destino, no la ruta completa.
msgid "panel.footer.unwritable"
msgstr "Can't write in {{folder}}"

msgid "actions.retry"
msgstr "Retry"

msgid "panel.footer.signing"
msgstr "Signing…"

msgid "panel.footer.addCertificate"
msgstr "Add a certificate…"

msgid "panel.signed.title"
msgstr "Document signatures"

#. Recuento de firmas del documento, en la insignia del resumen.
msgid "panel.signed.count"
msgid_plural "panel.signed.count"
msgstr[0] "1 signature"
msgstr[1] "{{count}} signatures"
msgstr[2] "{{count}} signatures"

#. {{number}} es el ordinal de la firma en el documento.
msgid "panel.signed.signature"
msgstr "Signature {{number}}"

#. {{number}} es el ordinal jerárquico de la contrafirma («1.1»), dentro de la firma que contrafirma.
msgid "panel.signed.countersignature"
msgstr "Countersignature {{number}}"

#. Recuento de contrafirmas del documento, junto al de firmas en la insignia del resumen.
msgid "panel.signed.countersignatureCount"
msgid_plural "panel.signed.countersignatureCount"
msgstr[0] "1 countersignature"
msgstr[1] "{{count}} countersignatures"
msgstr[2] "{{count}} countersignatures"

#. La insignia de la firma recién hecha en el resumen.
msgid "panel.signed.new"
msgstr "New"

msgid "panel.signed.field.signer"
msgstr "Signer"

msgid "panel.signed.field.onBehalfOf"
msgstr "On behalf of"

msgid "panel.signed.field.issuer"
msgstr "Issuer"

#. Rótulo de la fecha de la firma: en la ficha de una firma y como dato de la frase de la firma visible.
msgid "panel.signed.field.date"
msgstr "Date"

#. El rótulo de la fecha de una firma con sello de tiempo de una TSA.
msgid "panel.signed.field.sealed"
msgstr "Sealed"

#. El rótulo de la última fila de una ficha caducada o no válida.
msgid "panel.signed.field.reason"
msgstr "Reason"

#. La validez de una firma, a la derecha de la cabecera de su ficha.
msgid "panel.signed.validity.valid"
msgstr "Valid"

msgid "panel.signed.validity.expired"
msgstr "Expired"

msgid "panel.signed.validity.invalid"
msgstr "Invalid"

#. La marca de la firma que cierra el documento a más firmas.
msgid "panel.signed.closesDocument"
msgstr "Accepts no further signatures"

#. El rótulo del pie del resumen, con el fichero firmado y «Cambiar».
msgid "panel.signed.document"
msgstr "Document"

msgid "panel.signed.none.title"
msgstr "No signatures"

msgid "panel.signed.unrecognized.title"
msgstr "Unrecognized format"

msgid "panel.signed.unrecognized.body"
msgstr "It is neither a PDF nor a CAdES or XAdES signature."

msgid "panel.signed.readFailed.title"
msgstr "The signatures could not be read"

#. {{time}} es la hora, ya formateada (p. ej. "11:04").
msgid "panel.signed.signedAt"
msgstr "Signed at {{time}}"

msgid "panel.signed.openDocument"
msgstr "Open the PDF"

msgid "panel.signed.openFile"
msgstr "Open the file"

#. Motivo de «Firmar» deshabilitado en el resumen de un fichero que no es PDF.
msgid "panel.signed.onlyPdfs"
msgstr "Only PDFs can be signed on the desktop"

msgid "panel.signed.openFolder"
msgstr "Open the folder"

msgid "progress.title"
msgstr "Signing the document…"

msgid "progress.stages.presign"
msgstr "Preparing the signature"

msgid "progress.stages.sign"
msgstr "Signing on the card"

msgid "progress.stages.postsign"
msgstr "Assembling the PDF"

msgid "progress.keepTheCard"
msgstr "Don't remove the card until it finishes."

#. El titular del diálogo de páginas sin firma visible: {{count}} páginas donde el recuadro no cabe.
msgid "sealLoss.title"
msgid_plural "sealLoss.title"
msgstr[0] "One page will be left without a visible signature"
msgstr[1] "{{count}} pages will be left without a visible signature"
msgstr[2] "{{count}} pages will be left without a visible signature"

#. Cuerpo del diálogo de páginas sin firma visible; el título, en plural, dice cuántas páginas son.
msgid "sealLoss.body"
msgstr ""
"The box doesn't fit on pages smaller than the one you placed it on. The "
"signature will be valid throughout the document."

msgid "actions.signAnyway"
msgstr "Sign anyway"

#. Titular de los diálogos «¿Firmar de todos modos?»: con alguna firma previa no válida y cuando la sede pide confirmar.
msgid "signAnyway.title"
msgstr "Sign anyway?"

#. El nombre de la fila de una firma en «¿Firmar de todos modos?»: su número y el firmante.
msgid "signAnyway.signature"
msgstr "Signature {{number}} · {{name}}"

#. Cierre del diálogo «¿Firmar de todos modos?»: el receptor puede rechazar el documento.
msgid "signAnyway.warning"
msgstr "The recipient might reject it."

#. Hallazgo del documento: cambió después de la última firma.
msgid "documentFinding.modifiedAfterLastSignature"
msgstr "It was modified after the last signature"

#. Hallazgo del documento: se rellenó un formulario después de firmar.
msgid "documentFinding.formFilledAfterSigning"
msgstr "The form was filled in after signing"

#. Hallazgo del documento: se añadió contenido encima de lo firmado.
msgid "documentFinding.contentAddedOnTop"
msgstr "Content was added on top of what was signed"

#. Hallazgo del documento tras firmar: el cambio es anterior a la firma propia.
msgid "documentFinding.modifiedBeforeYourSignature"
msgstr "It was modified before your signature"

#. Motivo de una firma caducada. {{date}}: cuándo caducó el certificado.
msgid "signatureReason.certificateExpired"
msgstr "The certificate expired on {{date}}"

#. Motivo de una firma caducada cuyo certificado no es el del firmante. {{holder}}: su titular; {{date}}: cuándo caducó.
msgid "signatureReason.certificateExpiredHolder"
msgstr "{{holder}}'s certificate expired on {{date}}"

#. Motivo de una firma no válida: el documento cambió tras firmarla.
msgid "signatureReason.modifiedAfterSigning"
msgstr "It was modified after signing"

#. Motivo de una firma no válida: ilegible o sin certificado.
msgid "signatureReason.damaged"
msgstr "The signature is damaged"

#. Motivo de una firma no válida. {{date}}: cuándo entra en vigor el certificado.
msgid "signatureReason.certificateNotYetValid"
msgstr "The certificate could not be used before {{date}}"

#. Motivo de una firma no válida: de un tipo que rFirma no lee.
msgid "signatureReason.unknownSignatureType"
msgstr "rFirma does not know this type of signature"

#. Motivo de una firma no válida: resume con MD5 o MD2.
msgid "signatureReason.unsupportedAlgorithm"
msgstr "It uses an unsupported digest algorithm (MD5 or MD2)"

#. Motivo de una firma no válida. {{name}}: quien cerró el documento a más firmas.
msgid "signatureReason.cosignNotAdmitted"
msgstr "{{name}} did not allow further signatures"

#. Motivo de una firma no válida: el documento no admitía más firmas y no se sabe quién.
msgid "signatureReason.cosignNotAdmittedUnnamed"
msgstr "The document did not allow further signatures"

#. La cabecera de «rfirma verify -v» de un documento sin firmas, tras el formato: «PAdES · sin firmas».
msgid "commandLine.verify.noSignatures"
msgstr "no signatures"

#. En la línea de una firma de «rfirma verify -v», la entidad en cuyo nombre firma. {{entity}}: la entidad.
msgid "commandLine.verify.onBehalfOf"
msgstr "on behalf of {{entity}}"

#. Rótulo de la ficha de «rfirma verify -vvv»: el número de serie del certificado.
msgid "commandLine.verify.field.serialNumber"
msgstr "Serial number"

#. Rótulo de la ficha de «rfirma verify -vvv»: el periodo de vigencia del certificado.
msgid "commandLine.verify.field.validity"
msgstr "Validity"

#. Rótulo de la ficha de «rfirma verify -vvv»: el algoritmo de la firma.
msgid "commandLine.verify.field.algorithm"
msgstr "Algorithm"

#. Rótulo de la ficha de «rfirma verify -vvv»: el perfil de la firma.
msgid "commandLine.verify.field.profile"
msgstr "Profile"

#. Vigencia de un certificado que solo dice cuándo empieza. {{date}}: el inicio.
msgid "commandLine.verify.validFrom"
msgstr "from {{date}}"

#. Vigencia de un certificado que solo dice cuándo acaba. {{date}}: el final.
msgid "commandLine.verify.validUntil"
msgstr "until {{date}}"

