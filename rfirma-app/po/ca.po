#. No se traduce: es el nombre de la aplicación.
msgid "app.name"
msgstr "rFirma"

msgid "actions.cancel"
msgstr "Cancel·lar"

msgid "actions.close"
msgstr "Tancar"

msgid "actions.change"
msgstr "Canviar"

msgid "actions.remove"
msgstr "Treure"

msgid "actions.dismiss"
msgstr "Descartar"

msgid "actions.copy"
msgstr "Copiar"

msgid "actions.back"
msgstr "Tornar"

#. Endónimo: el nombre del idioma en sí mismo, no se traduce.
msgid "languages.es"
msgstr "Español"

#. Endónimo: el nombre del idioma en sí mismo, no se traduce.
msgid "languages.ca"
msgstr "Català"

#. Endónimo: el nombre del idioma en sí mismo, no se traduce.
msgid "languages.eu"
msgstr "Euskara"

#. Endónimo: el nombre del idioma en sí mismo, no se traduce.
