msgstr "Vols que rFirma atengui els enllaços de les seus?"

msgid "urlHandler.banner.accept"
msgstr "Sí"

msgid "urlHandler.banner.later"
msgstr "Ara no"

msgid "urlHandler.banner.never"
msgstr "No tornar a preguntar"

msgid "header.menu"
msgstr "Menú"

msgid "header.preferences"
msgstr "Preferències…"

msgid "header.about"
msgstr "Quant a rFirma"

msgid "badges.signed"
msgstr "Signat"

msgid "badges.unsigned"
msgstr "Sense signar"

msgid "badges.unavailable"
msgstr "No disponible"

msgid "tray.dropZone"
msgstr "Arrossega un PDF o prem per obrir-lo"

msgid "tray.empty"
msgstr "Aquí apareixeran els documents que vagis signant"

msgid "tray.recents"
msgstr "Recents"

msgid "tray.remove"
msgstr "Treure de la llista"

msgid "viewer.dropZone"
msgstr "Arrossega un PDF o prem per obrir-lo"

msgid "viewer.dropZoneHint"
msgstr "S'obrirà l'explorador de fitxers"

msgid "viewer.privacy"
msgstr "Només PDF. El document no surt del teu ordinador en cap moment."

msgid "viewer.pageNumber"
msgstr "Número de pàgina"

#. {{total}} es el número de páginas del documento.
msgid "viewer.pageOf"
msgstr "de {{total}}"

msgid "viewer.firstPage"
msgstr "Primera pàgina"

msgid "viewer.previousPage"
msgstr "Pàgina anterior"

msgid "viewer.nextPage"
msgstr "Pàgina següent"

msgid "viewer.lastPage"
msgstr "Última pàgina"

msgid "viewer.zoomOut"
msgstr "Allunyar"

msgid "viewer.zoomIn"
msgstr "Apropar"

#. Rótulo del campo donde se teclea el porcentaje de zoom.
msgid "viewer.zoomLevel"
msgstr "Nivell de zoom"

#. Botón: la hoja ocupa todo el ancho disponible.
msgid "viewer.fitWidth"
msgstr "Ajustar a l'amplada"

#. Botón: la página entera cabe en el visor.
msgid "viewer.fitPage"
msgstr "Ajustar a la pàgina"

#. Nombre accesible de la hoja del documento, que se enfoca para pasar de página.
msgid "viewer.sheet"
msgstr "Full del document"

msgid "viewer.signatureBox"
msgstr "Requadre de la signatura visible"

msgid "viewer.dragHandle"
msgstr "Arrossega per col·locar"

msgid "viewer.outOfPage"
msgstr "El requadre ha quedat fora de la pàgina, així que continua on era."

msgid "viewer.stamp.frozen"
msgstr "Segell congelat mentre mous el requadre"

msgid "viewer.stamp.onDemand"
msgstr "Document gran: el segell no es recalcula sol"

msgid "viewer.stamp.show"
msgstr "Veure com queda"

msgid "viewer.stamp.composing"
msgstr "Component el segell amb el certificat triat"

msgid "viewer.stamp.failed"
msgstr "No s'ha pogut dibuixar el segell"

msgid "viewer.stamp.retry"
msgstr "Tornar-ho a intentar"

msgid "panel.document.pages"
msgid_plural "panel.document.pages"
msgstr[0] "1 pàgina"
msgstr[1] "{{count}} pàgines"
msgstr[2] "{{count}} pàgines"

msgid "panel.coSignature"
msgid_plural "panel.coSignature"
msgstr[0] "Ja porta 1 signatura: la teva serà una cosignatura."
msgstr[1] "Ja porta {{count}} signatures: la teva serà una cosignatura."
msgstr[2] "Ja porta {{count}} signatures: la teva serà una cosignatura."

#. Rótulo del bloque con las tres opciones de en qué páginas se sella.
msgid "panel.placement.title"
msgstr "Col·locació"

msgid "panel.placement.single"
msgstr "Només 1 pàgina"

#. Pie de «Solo 1 página»: {{page}} es la página donde se colocó el recuadro.
msgid "panel.placement.singlePage"
msgstr "Pàgina {{page}}"

#. Pie de «Solo 1 página» cuando todavía no hay recuadro en ninguna página.
msgid "panel.placement.singleUnplaced"
msgstr "encara sense col·locar"

msgid "panel.placement.these"
msgstr "Aquestes pàgines"

#. Nombre del campo donde se teclean las páginas, para quien usa lector de pantalla.
msgid "panel.placement.field"
msgstr "Pàgines on se segella"

#. {{pages}} es el número de páginas del documento.
msgid "panel.placement.all"
msgstr "Totes les pàgines ({{pages}})"

#. Botón que sella la página que se está mirando. Cara por omisión, con «Solo 1 página» o «Estas páginas».
msgid "panel.placement.seal"
msgstr "Segellar aquesta pàgina"

#. Botón que sella, con «Todas las páginas» activa: el conjunto ya está completo y falta el recuadro.
msgid "panel.placement.sealAll"
msgstr "Col·locar el segell aquí"

#. Botón que quita el sello de la página que se está mirando, cuando ya lo lleva.
msgid "panel.placement.unseal"
msgstr "Treure el segell"

#. {{pages}} son las primeras páginas del conjunto, ya escritas y separadas por comas.
msgid "panel.placement.echo"
msgstr "Se segellarà a les pàgines {{pages}}."

#. Igual que panel.placement.echo, con {{count}} páginas más que no se nombran.
msgid "panel.placement.echoMore"
msgid_plural "panel.placement.echoMore"
msgstr[0] "Se segellarà a les pàgines {{pages}} i 1 més."
msgstr[1] "Se segellarà a les pàgines {{pages}} i {{count}} més."
msgstr[2] "Se segellarà a les pàgines {{pages}} i {{count}} més."

#. Se estampa un solo campo de firma con el recuadro replicado, no una firma por página.
msgid "panel.placement.replicated"
msgid_plural "panel.placement.replicated"
msgstr[0] ""
"El mateix requadre, al mateix lloc i de la mateixa mida, en 1 pàgina."
msgstr[1] ""
"El mateix requadre, al mateix lloc i de la mateixa mida, a les {{count}} "
"pàgines: és un sol camp de signatura repetit, no {{count}} signatures."
msgstr[2] ""
"El mateix requadre, al mateix lloc i de la mateixa mida, a les {{count}} "
"pàgines: és un sol camp de signatura repetit, no {{count}} signatures."

#. {{pageCount}} son las páginas del documento y {{page}} la más alta que se ha escrito.
msgid "panel.placement.errors.beyond"
msgstr "El document té {{pageCount}} pàgines i has escrit fins a la {{page}}."

#. {{entry}} es el rango tal y como se ha escrito, por ejemplo 3-1.
msgid "panel.placement.errors.reversed"
msgstr "«{{entry}}» va al revés: el primer número ha de ser el més petit."

msgid "panel.placement.errors.zero"
msgstr "No hi ha pàgina 0: la primera és la 1."

#. {{entry}} es lo que se ha escrito y no se entiende. El ejemplo del final no se traduce.
msgid "panel.placement.errors.malformed"
msgstr ""
"«{{entry}}» no s'entén. Números i intervals separats per comes: 1,2-3,10-20."

#. El campo de páginas está vacío: no nombra ninguna, así que no se puede firmar.
msgid "panel.placement.errors.empty"
msgstr "Escriu a quines pàgines se segella: 1,2-3,10-20."

msgid "panel.certificate.title"
msgstr "Certificat"

msgid "panel.certificate.loading"
msgstr "Cercant certificats…"

#. {{issuer}} es el nombre de la entidad emisora del certificado.
msgid "panel.certificate.issuer"
msgstr "Emès per {{issuer}}"

msgid "panel.certificate.choose"
msgstr "Triar certificat"

msgid "panel.certificate.list"
msgstr "Certificats disponibles"

msgid "panel.certificate.groups.available"
msgstr "Disponibles"

msgid "panel.certificate.groups.unusable"
msgstr "No utilitzables"

msgid "panel.certificate.stores.card"
msgstr "Targeta"

msgid "panel.certificate.stores.firefox"
msgstr "Firefox"

msgid "panel.certificate.stores.chrome"
msgstr "Chrome"

#. Término del dominio: NSS es el almacén de certificados de Firefox y Chrome; no se traduce la sigla.
msgid "panel.certificate.stores.nssdb"
msgstr "Magatzem NSS"

msgid "panel.certificate.stores.installed"
msgstr "Instal·lat a rFirma"

msgid "panel.certificate.retry"
msgstr "Tornar a cercar"

msgid "panel.certificate.otherModule"
msgstr "Un altre mòdul…"

msgid "panel.certificate.empty.title"
msgstr "No hem trobat cap certificat"

msgid "panel.certificate.empty.body"
msgstr ""
"Si fas servir una targeta, comprova que està inserida i que el lector està "
"connectat."

msgid "panel.certificate.failed.title"
msgstr "No hem pogut cercar els certificats"

msgid "panel.certificate.failed.body"
msgstr "La cerca ha fallat abans d'acabar, així que no sabem si n'hi ha cap."

#. {{date}} es la fecha de caducidad, ya formateada según el idioma.
msgid "panel.certificate.expired"
msgstr "El certificat va caducar el {{date}}, així que no s'hi pot signar."

msgid "panel.certificate.notYetValid"
msgstr "El certificat encara no és vigent, així que no s'hi pot signar."

#. {{reason}} es el motivo de la revocación, tal como lo da el certificado.
msgid "panel.certificate.revoked"
msgstr "El certificat està revocat ({{reason}}), així que no s'hi pot signar."

msgid "panel.certificate.unreadable"
msgstr "No hem pogut llegir aquest certificat, així que no s'hi pot signar."

msgid "panel.visibleSignature.title"
msgstr "Signatura visible"

msgid "panel.visibleSignature.toggle"
msgstr "Estampar un requadre de signatura al document"

msgid "panel.visibleSignature.content"
msgstr "Contingut"

msgid "panel.visibleSignature.fields.rubric"
msgstr "Rúbrica"

msgid "panel.visibleSignature.fields.rubricDisabled"
msgstr "Tria abans una imatge"

msgid "panel.visibleSignature.fields.signerName"
msgstr "Signant"

msgid "panel.visibleSignature.fields.issuer"
msgstr "Emissor"

msgid "panel.visibleSignature.fields.signedAt"
msgstr "Data"

msgid "panel.visibleSignature.fields.reason"
msgstr "Motiu"

msgid "panel.visibleSignature.reason.label"
msgstr "Motiu"

msgid "panel.visibleSignature.reason.placeholder"
msgstr "Conforme"

msgid "panel.visibleSignature.rubric.title"
msgstr "Imatge de la rúbrica"

msgid "panel.visibleSignature.rubric.choose"
msgstr "Triar imatge"

msgid "panel.visibleSignature.rubric.change"
msgstr "Canviar imatge"

msgid "panel.visibleSignature.rubric.thumbnail"
msgstr "La teva rúbrica, tal com s'estamparà"

msgid "panel.visibleSignature.rubric.flattened"
msgstr ""
"S'estampa sobre blanc: el requadre va al PDF com a JPEG i un JPEG no té "
"transparència."

#. Aviso sobre el bloque de firma visible apagado: sin certificado no hay sello que dibujar.
msgid "panel.visibleSignature.noCertificate"
msgstr "Tria un certificat per col·locar la signatura visible"

#. Manda hacer la acción que falta: sin recuadro colocado no se puede firmar.
msgid "panel.footer.placeFirst"
msgstr ""
"Col·loca la signatura sobre el document: arrossega un requadre o prem el "
"botó de segellar."

msgid "panel.footer.savedIn"
msgstr "Es desarà a"

#. {{folder}} es la ruta corta de la carpeta de destino, no la ruta completa.
msgid "panel.footer.unwritable"
msgstr "No es pot escriure a {{folder}}"

msgid "panel.footer.retry"
msgstr "Tornar-ho a intentar"

msgid "panel.signed.summary"
msgstr "Resum"

#. Término del dominio: PAdES es la sigla del formato de firma; no se traduce.
msgid "panel.signed.format"
