{
    # Opciones globales: Coolify actúa como frontal gestionando TLS externamente
    admin off
    auto_https off

    servers {
        trusted_proxies static 10.0.1.0/24 fd8f:711f:6e73::/64
    }
}

# Cabeceras de seguridad y privacidad. Van en un fragmento porque las
# respuestas de `handle_errors` no heredan las del sitio.
(cabeceras) {
    header {
        # Ocultar huella del servidor
        -Server

        # Prevención de ataques comunes
        X-Frame-Options "DENY"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "strict-origin-when-cross-origin"
        Permissions-Policy "camera=(), microphone=(), geolocation=()"
        Content-Security-Policy "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval'; frame-ancestors 'none'; base-uri 'self'; form-action 'self';"
    }
}

:3000 {
    encode zstd gzip

    log {
        output stdout
    }

    # Endpoint de comprobación de estado para Coolify / Docker
    handle /healthz {
        respond "OK" 200
    }

    import cabeceras

    # Denegar acceso a ficheros o directorios ocultos (dotfiles)
    @hidden path */.*
    error @hidden 404

    # LOS TRES REPOSITORIOS Y LA CLAVE NO ESTÁN EN LA IMAGEN: viven en el
    # montaje de directorio del anfitrión, y se sirven **a través del enlace
    # simbólico `actual`** (ADR-0015). Ese enlace es todo lo que cambia en un
    # despliegue: la publicación sube el árbol nuevo a `arboles/<etiqueta>` y
    # lo último que hace es reapuntar `actual`, así que aquí nunca se ve un
    # árbol a medias y la vuelta atrás no toca esta configuración.
    #
    # Las rutas están fijadas por el ADR-0015 —viajan dentro del
    # `.flatpakref` y de las órdenes de alta publicadas—, así que se enumeran
    # en vez de servir el montaje entero: lo que no esté en esta lista no se
    # sirve aunque alguien lo deje ahí.
    @repositorio path /flatpak/* /apt/* /rpm/* /rfirma.asc /rfirma.flatpakref /rfirma.flatpakrepo /windows/*
    handle @repositorio {
        root * /srv/rfirma-repo/actual
        header /rfirma.flatpakrepo Content-Type application/vnd.flatpak.repo
        file_server
    }

    # La landing, que sí va dentro de la imagen: la construye `astro build` en
    # cinco idiomas —`/` en castellano y `/ca/`, `/eu/`, `/gl/` y `/en/`— y sus
    # hojas, tipografías e imágenes salen con el hash en el nombre bajo
    # `/_astro/`. De ahí las dos caducidades: lo que lleva hash no cambia nunca
    # y lo demás se revalida, para que un redespliegue se vea de inmediato.
    handle {
        root * /srv
        file_server
        @sellado path /_astro/*
        header @sellado Cache-Control "public, max-age=31536000, immutable"
        @paginas not path /_astro/*
        header @paginas Cache-Control "no-cache, must-revalidate"
    }

    # La 404 de la landing, con su estado, para cualquier ruta que no exista.
    # Las de los repositorios siguen respondiendo el 404 desnudo de siempre:
    # quien las pide es apt, dnf o flatpak, no una persona.
    handle_errors 404 {
        import cabeceras
        @web not path /flatpak/* /apt/* /rpm/* /rfirma.asc /rfirma.flatpakref /rfirma.flatpakrepo /windows/*
        handle @web {
            root * /srv
            rewrite * /404.html
            header Cache-Control "no-cache, must-revalidate"
            file_server
        }
    }
}
